def column (b : Fin 19) (j : Fin 10) : Fin 190 := ⟨b.val*10+j.val,by omega⟩
def Block (b : Fin 19) : Prop := ∀ j : Fin 10,
    (Fast.inputM 0 (column b j)).lo=(cachedM (column b j)).lo ∧
    (Fast.inputM 0 (column b j)).hi=(cachedM (column b j)).hi
theorem block00 : Block 0 := by unfold Block; decide +kernel
theorem block01 : Block 1 := by unfold Block; decide +kernel
theorem block02 : Block 2 := by unfold Block; decide +kernel
theorem block03 : Block 3 := by unfold Block; decide +kernel
theorem block04 : Block 4 := by unfold Block; decide +kernel
theorem block05 : Block 5 := by unfold Block; decide +kernel
theorem block06 : Block 6 := by unfold Block; decide +kernel
theorem block07 : Block 7 := by unfold Block; decide +kernel
theorem block08 : Block 8 := by unfold Block; decide +kernel
theorem block09 : Block 9 := by unfold Block; decide +kernel
theorem block10 : Block 10 := by unfold Block; decide +kernel
theorem block11 : Block 11 := by unfold Block; decide +kernel
theorem block12 : Block 12 := by unfold Block; decide +kernel
theorem block13 : Block 13 := by unfold Block; decide +kernel
theorem block14 : Block 14 := by unfold Block; decide +kernel
theorem block15 : Block 15 := by unfold Block; decide +kernel
theorem block16 : Block 16 := by unfold Block; decide +kernel
theorem block17 : Block 17 := by unfold Block; decide +kernel
theorem block18 : Block 18 := by unfold Block; decide +kernel

theorem blocks (b : Fin 19) : Block b := by
  fin_cases b
  · exact block00
  · exact block01
  · exact block02
  · exact block03
  · exact block04
  · exact block05
  · exact block06
  · exact block07
  · exact block08
  · exact block09
  · exact block10
  · exact block11
  · exact block12
  · exact block13
  · exact block14
  · exact block15
  · exact block16
  · exact block17
  · exact block18

theorem cachedM_fields (h : Fin 190) :
    (Fast.inputM 0 h).lo=(cachedM h).lo ∧ (Fast.inputM 0 h).hi=(cachedM h).hi := by
  have hh := blocks ⟨h.val/10,by omega⟩ ⟨h.val%10,by omega⟩
  have heq : column ⟨h.val/10,by omega⟩ ⟨h.val%10,by omega⟩=h := by apply Fin.ext; simp [column]; omega
  simpa only [heq] using hh
theorem cachedM_mem (h : Fin 190) : FixedInterval.Mem unitScale (cachedM h) (M 0 h) := by
  have hh := Fast.M_mem 0 h
  change (cachedM h).lo≤(unitScale : ℝ)*M 0 h ∧ (unitScale : ℝ)*M 0 h≤(cachedM h).hi
  rw [← (cachedM_fields h).1,← (cachedM_fields h).2]
  exact hh
