def rowOf : Fin 3 → TermIndex → Fin 155 := ![rowOf0,rowOf1,rowOf2]
theorem row_shape : ∀ (axis : Fin 3) (row : Fin 155) (k : Fin (rows axis row).length) (a : Fin 3),
    exponents ((rows axis row)[k.val]) a=if a=axis then k.val else base axis row a := by decide +kernel

theorem row_inverse : ∀ (axis : Fin 3) (row : Fin 155) (k : Fin (rows axis row).length),
    rowOf axis ((rows axis row)[k.val])=row := by decide +kernel

theorem row_base_zero : ∀ (axis : Fin 3) (row : Fin 155), base axis row axis=0 := by decide +kernel

theorem rows_partition : ∀ axis : Fin 3, ((List.finRange 155).flatMap (rows axis)).Perm allTerms := by decide +kernel
