theorem relative_bounds : ∀ a, (relativeBox a).lo≤((sourceBox a).sub (LocalShift.centerInterval localId a)).lo ∧
    ((sourceBox a).sub (LocalShift.centerInterval localId a)).hi≤(relativeBox a).hi := by decide +kernel
theorem actual_residual_nonnegative_on_source (p : Fin 3 → ℝ) (hp : ∀ a, (sourceBox a).mem (p a)) :
    0≤ActualR.residual p := by
  have hx (a : Fin 3) : (relativeBox a).mem (p a-LocalShift.center localId a) :=
    Interval.RatInterval.mem_subset (Interval.RatInterval.mem_sub (hp a) (LocalShift.center_interval_mem localId a))
      (relative_bounds a).1 (relative_bounds a).2
  have h := actual_residual_nonnegative (fun a => p a-LocalShift.center localId a) hx
  have he : (fun a => LocalShift.center localId a+(p a-LocalShift.center localId a))=p := by
    funext a
    ring
  rw [he] at h
  exact h
