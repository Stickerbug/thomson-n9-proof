theorem test_t288_corners (c : TermIndex → ℝ) (x : Fin 3 → ℝ)
    (hC : ∀ k, (coefficientInterval k).mem (c k))
    (hP : PowerEnclosures (fun _ n => powerTable n) x) :
    K.mem (hessianTerm c x .t288) := by
  have hterm : hessianTerm c x .t288 = (c .t288 * 2) * (x 1 ^ 3 * x 2) := by
    unfold hessianTerm derivativeCoeff monomial
    rw [show exponents .t288 = ![2, 3, 1] from rfl]
    norm_num [lowerExponent]
  rw [hterm]
  have hcI : I.mem (c .t288 * 2) := by
    constructor
    · have h := (hC .t288).1
      rw [show (coefficientInterval .t288).lo = qAlo from rfl] at h
      norm_num [I, qIlo, qAlo] at h ⊢
      linarith
    · have h := (hC .t288).2
      rw [show (coefficientInterval .t288).hi = qAhi from rfl] at h
      norm_num [I, qIhi, qAhi] at h ⊢
      linarith
  have hJmem : J.mem (x 1 ^ 3 * x 2) := by
    refine mem_mul_of_bounds (hP 1 3) (by simpa using hP 2 1) ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
    all_goals
      simp only [J, powerTable, finitePower, power_03, power_01]
      rw [Rat.le_iff]
      norm_num [qJlo, qJhi]
  have hmain : K.mem ((c .t288 * 2) * (x 1 ^ 3 * x 2)) := by
    refine mem_mul_of_bounds hcI hJmem ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
    all_goals
      simp only [I, J, K]
      rw [Rat.le_iff]
      norm_num [qIlo, qIhi, qJlo, qJhi, qKlo, qKhi]
  simpa using hmain
