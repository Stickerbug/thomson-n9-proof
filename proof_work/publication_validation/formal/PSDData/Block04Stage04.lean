import PSDData.Block04Stage05
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000000
noncomputable section
namespace ThomsonNine.ContactPSD.Block04Stage04
open ThomsonNine.FixedInterval ThomsonNine.FixedInterval.Schur ThomsonNine.ActualHermite.CoefficientData
open ThomsonNine.Interval (RatInterval)
def matrix : Fin 1 → Fin 1 → Bounds := ![![⟨, ⟩]]
def inverse : Bounds := ⟨, ⟩
def pivotInterval : RatInterval := ⟨( : ℚ), ( : ℚ), by decide +kernel⟩
def inverseInterval : RatInterval := ⟨( : ℚ), ( : ℚ), by decide +kernel⟩
theorem positive : 0<(matrix 0 0).lo := by decide +kernel
theorem inverse_rule : InverseRule unitScale (matrix 0 0) inverse := by
  apply inverseRule_of_rat unitScale_pos (matrix 0 0) inverse pivotInterval inverseInterval <;> decide +kernel
theorem next_bounds : ∀ i j : Fin 0, Contains (Block04Stage05.matrix i j) (reducedMatrix unitScale matrix inverse i j) := by
  unfold Contains
  decide +kernel
theorem certificate : PSDSound unitScale matrix :=
  step_psdSound unitScale_pos matrix Block04Stage05.matrix inverse positive inverse_rule next_bounds Block04Stage05.certificate
end ThomsonNine.ContactPSD.Block04Stage04
