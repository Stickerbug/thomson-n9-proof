def monomial (e : Exponent) (u v t : ℝ) : ℝ := u^(e 0)*v^(e 1)*t^(e 2)
def eval (n : Fin 11) (u v t : ℝ) : ℝ := ((terms n).map (fun x => (x.2 : ℝ)*monomial x.1 u v t)).sum
theorem eval_zero (u v t : ℝ) : eval 0 u v t=1 := by simp [eval,terms,monomial]
theorem eval_one (u v t : ℝ) : eval 1 u v t=t-u*v := by simp [eval,terms,monomial]; ring
theorem recurrence00 (u v t : ℝ) :
    eval 2 u v t=2*(t-u*v)*eval 1 u v t-(1-u^2)*(1-v^2)*eval 0 u v t := by
  norm_num [eval,terms,monomial]
  ring
theorem recurrence01 (u v t : ℝ) :
    eval 3 u v t=2*(t-u*v)*eval 2 u v t-(1-u^2)*(1-v^2)*eval 1 u v t := by
  norm_num [eval,terms,monomial]
  ring
theorem recurrence02 (u v t : ℝ) :
    eval 4 u v t=2*(t-u*v)*eval 3 u v t-(1-u^2)*(1-v^2)*eval 2 u v t := by
  norm_num [eval,terms,monomial]
  ring
theorem recurrence03 (u v t : ℝ) :
    eval 5 u v t=2*(t-u*v)*eval 4 u v t-(1-u^2)*(1-v^2)*eval 3 u v t := by
  norm_num [eval,terms,monomial]
  ring
theorem recurrence04 (u v t : ℝ) :
    eval 6 u v t=2*(t-u*v)*eval 5 u v t-(1-u^2)*(1-v^2)*eval 4 u v t := by
  norm_num [eval,terms,monomial]
  ring
theorem recurrence05 (u v t : ℝ) :
    eval 7 u v t=2*(t-u*v)*eval 6 u v t-(1-u^2)*(1-v^2)*eval 5 u v t := by
  norm_num [eval,terms,monomial]
  ring
theorem recurrence06 (u v t : ℝ) :
    eval 8 u v t=2*(t-u*v)*eval 7 u v t-(1-u^2)*(1-v^2)*eval 6 u v t := by
  norm_num [eval,terms,monomial]
  ring
theorem recurrence07 (u v t : ℝ) :
    eval 9 u v t=2*(t-u*v)*eval 8 u v t-(1-u^2)*(1-v^2)*eval 7 u v t := by
  norm_num [eval,terms,monomial]
  ring
theorem recurrence08 (u v t : ℝ) :
    eval 10 u v t=2*(t-u*v)*eval 9 u v t-(1-u^2)*(1-v^2)*eval 8 u v t := by
  norm_num [eval,terms,monomial]
  ring
theorem recurrence (k : Fin 9) (u v t : ℝ) :
    eval ⟨k.val+2,by omega⟩ u v t=2*(t-u*v)*eval ⟨k.val+1,by omega⟩ u v t-(1-u^2)*(1-v^2)*eval ⟨k.val,by omega⟩ u v t := by
  fin_cases k
  · exact recurrence00 u v t
  · exact recurrence01 u v t
  · exact recurrence02 u v t
  · exact recurrence03 u v t
  · exact recurrence04 u v t
  · exact recurrence05 u v t
  · exact recurrence06 u v t
  · exact recurrence07 u v t
  · exact recurrence08 u v t

theorem eval_eq_Q3 (n : Fin 11) (u v t : ℝ) : eval n u v t=ThreePoint.Q3 n u v t := by
  have h : ∀ k : ℕ, (hk : k≤10) → eval ⟨k,by omega⟩ u v t=ThreePoint.Q3 k u v t := by
    intro k
    induction k using Nat.strong_induction_on with
    | h k ih =>
      intro hk
      cases k with
      | zero => exact eval_zero u v t
      | succ k =>
        cases k with
        | zero => exact eval_one u v t
        | succ k =>
          rw [recurrence ⟨k,by omega⟩,ih (k+1) (by omega) (by omega),ih k (by omega) (by omega)]
          rfl
  exact h n (by omega)
end ThomsonNine.QPolynomial
