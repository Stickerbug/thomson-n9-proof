  ⟨(-1 / 2 : ℚ), (-1 / 2 : ℚ), by decide +kernel⟩,
  ⟨(-2 / 5 : ℚ), (-2 / 5 : ℚ), by decide +kernel⟩,
  ⟨(-1 / 5 : ℚ), (-1 / 5 : ℚ), by decide +kernel⟩,
  ⟨( /  : ℚ), ( /  : ℚ), by decide +kernel⟩,
  ⟨(1 / 10 : ℚ), (1 / 10 : ℚ), by decide +kernel⟩,
  ⟨( /  : ℚ), ( /  : ℚ), by decide +kernel⟩,
  ⟨(2368973273495276316067270214935143164771955304445306097225075347014061931978506565381372900035241788628187630177993838626441783081536861505630146539140560995853306323439527394582648042788673233481680189573381553796887970226863480954571295739 / 6668014432879854274079851790721257797144758322315908160396257811764037237817632071521432200871554290742929910593433240445888801654119365080363356052330830046095157579514014558463078285911814024728965016135886601981690748037476461291163877376 : ℚ), (4737946546990552632134540429870286329543910608890612194450150694028123863957013130762745800070483577256375260355987677252883566163073723011260293078281121991706612646879054789165296085577346466963360379146763107593775940453726961909142591479 / 13336028865759708548159703581442515594289516644631816320792515623528074475635264143042864401743108581485859821186866480891777603308238730160726712104661660092190315159028029116926156571823628049457930032271773203963381496074952922582327754752 : ℚ), by decide +kernel⟩,
