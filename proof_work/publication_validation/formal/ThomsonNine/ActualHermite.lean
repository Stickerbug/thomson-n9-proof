set_option maxRecDepth 100000
set_option maxHeartbeats 10000000
noncomputable section
namespace ThomsonNine.ActualHermite
open Polynomial
open ThomsonNine.Interval ThomsonNine.Interval.RatInterval
open ThomsonNine.RefinedRadius

def node : Fin 14 → ℝ := ![-1,-9/10,radius^2/2-1,-radius,-1/2,-2/5,-1/5,
  2*radius^2-1,1/10,1-3*radius^2/2,radius/2,9/20,13/25,14/25]

def computed : Fin 14 → RatInterval := ![const (-1),const (-9/10),
  sub (mul (mul tightEnclosure tightEnclosure) (const (1/2))) (const 1),
  neg tightEnclosure,const (-1/2),const (-2/5),const (-1/5),
  sub (mul (mul tightEnclosure tightEnclosure) (const 2)) (const 1),const (1/10),
  sub (const 1) (mul (mul tightEnclosure tightEnclosure) (const (3/2))),
  mul tightEnclosure (const (1/2)),const (9/20),const (13/25),const (14/25)]

