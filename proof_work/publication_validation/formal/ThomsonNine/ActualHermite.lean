theorem computed_mem : ∀ i : Fin 14, (computed i).mem (node i) := by
  have hr2 : (mul tightEnclosure tightEnclosure).mem (radius^2) := by
    simpa only [pow_two] using mem_mul radius_mem_tight radius_mem_tight
  have hhalf : (mul (mul tightEnclosure tightEnclosure) (const (1/2))).mem (radius^2/2) := by
    convert mem_mul hr2 (mem_const (1/2)) using 1 <;> first | rfl | norm_num [div_eq_mul_inv]
  have hdouble : (mul (mul tightEnclosure tightEnclosure) (const 2)).mem (2*radius^2) := by
    convert mem_mul hr2 (mem_const 2) using 1 <;> first | rfl | (norm_num; try ring)
  have hthreehalf : (mul (mul tightEnclosure tightEnclosure) (const (3/2))).mem (3*radius^2/2) := by
    convert mem_mul hr2 (mem_const (3/2)) using 1 <;> first | rfl | (norm_num [div_eq_mul_inv]; try ring)
  have hrhalf : (mul tightEnclosure (const (1/2))).mem (radius/2) := by
    convert mem_mul radius_mem_tight (mem_const (1/2)) using 1 <;> first | rfl | norm_num [div_eq_mul_inv]
  intro i
  fin_cases i
  · simpa [computed,node] using mem_const (-1)
  · simpa [computed,node] using mem_const (-9/10)
  · simpa [computed,node] using mem_sub hhalf (mem_const 1)
  · simpa [computed,node] using mem_neg radius_mem_tight
  · simpa [computed,node] using mem_const (-1/2)
  · simpa [computed,node] using mem_const (-2/5)
  · simpa [computed,node] using mem_const (-1/5)
  · simpa [computed,node] using mem_sub hdouble (mem_const 1)
  · simpa [computed,node] using mem_const (1/10)
  · simpa [computed,node] using mem_sub (mem_const 1) hthreehalf
  · simpa [computed,node] using hrhalf
  · simpa [computed,node] using mem_const (9/20)
  · simpa [computed,node] using mem_const (13/25)
  · simpa [computed,node] using mem_const (14/25)

theorem node_bounds : ∀ i : Fin 14,
    (nodeInterval i).lo ≤ (computed i).lo ∧ (computed i).hi ≤ (nodeInterval i).hi := by
  decide +kernel

theorem node_mem (i : Fin 14) : (nodeInterval i).mem (node i) :=
  mem_subset (computed_mem i) (node_bounds i).1 (node_bounds i).2

theorem node_separated : ∀ i j : Fin 14, i<j → (nodeInterval i).hi < (nodeInterval j).lo := by
  decide +kernel

theorem node_strictMono : StrictMono node := by
  intro i j hij
  have hs : ((nodeInterval i).hi : ℝ) < (nodeInterval j).lo := by exact_mod_cast node_separated i j hij
  exact ((node_mem i).2.trans_lt hs).trans_le (node_mem j).1

theorem node_injective : Function.Injective node := node_strictMono.injective

theorem node_upper_bounds : ∀ i : Fin 14, (nodeInterval i).hi < 1 := by decide +kernel

theorem node_lt_one (i : Fin 14) : node i < 1 := by
  have h : ((nodeInterval i).hi : ℝ) < 1 := by exact_mod_cast node_upper_bounds i
  exact (node_mem i).2.trans_lt h

def value (i : Fin 14) : ℝ := (Real.sqrt (2-2*node i))⁻¹

def H : ℝ[X] := HermiteInterpolation.interpolate node value (fun i => (value i)^3)

theorem H_eval (i : Fin 14) : H.eval (node i) = value i :=
  HermiteInterpolation.interpolate_eval node value (fun i => (value i)^3) node_injective i

theorem H_derivative_eval (i : Fin 14) : H.derivative.eval (node i) = (H.eval (node i))^3 := by
  rw [H_eval]
  exact HermiteInterpolation.interpolate_derivative_eval node value (fun i => (value i)^3) node_injective i

theorem value_square (i : Fin 14) : (2-2*node i)*(value i)^2 = 1 := by
  have hx : 0 < 2-2*node i := by linarith [node_lt_one i]
  have hs : Real.sqrt (2-2*node i) ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr hx)
  have hs2 := Real.sq_sqrt (le_of_lt hx)
  unfold value
  rw [inv_pow,hs2]
  exact mul_inv_cancel₀ (ne_of_gt hx)

theorem H_natDegree : H.natDegree ≤ 27 := by
  have h := HermiteInterpolation.interpolate_natDegree node value (fun i => (value i)^3) node_injective
  simpa only [H,Fintype.card_fin] using h

theorem exists_quotient : ∃ Q : ℝ[X], HermiteFactor.G H =
    (∏ i : Fin 14, (X-C (node i))^2)*Q := by
  apply HermiteFactor.exists_hermite_quotient H node node_injective
  · intro i; rw [H_eval]; exact value_square i
  · exact H_derivative_eval

end ThomsonNine.ActualHermite
