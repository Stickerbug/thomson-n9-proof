private theorem term_mem_600 (c : TermIndex → ℝ) (x : Fin 3 → ℝ)
    (hC : ∀ k, (coefficientInterval k).mem (c k))
    (hP : PowerEnclosures (fun _ n => powerTable n) x) :
    termBound_600.mem (hessianTerm c x .t600) := by
  have hterm : hessianTerm c x .t600 =
      (c .t600 * 30) * ((x 0 ^ 4) * (x 1 ^ 5)) := by
    unfold hessianTerm derivativeCoeff monomial
    rw [show exponents .t600 = ![6, 5, 0] from rfl]
    norm_num [lowerExponent]
    try ring
    try simp
  rw [hterm]
  have hcI : I_600.mem (c .t600 * 30) := by
    constructor
    · have h := (hC .t600).1
      rw [show (coefficientInterval .t600).lo = qAlo_600 from rfl] at h
      norm_num [I_600, qIlo_600, qAlo_600] at h ⊢
      linarith
    · have h := (hC .t600).2
      rw [show (coefficientInterval .t600).hi = qAhi_600 from rfl] at h
      norm_num [I_600, qIhi_600, qAhi_600] at h ⊢
      linarith
  have hJmem : J_600.mem ((x 0 ^ 4) * (x 1 ^ 5)) := by
    refine mem_mul_of_bounds (by simpa using hP 0 4) (by simpa using hP 1 5) ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
    all_goals
      simp only [J_600, powerTable, finitePower, power_04, power_05]
      rw [Rat.le_iff]
      norm_num [qJlo_600, qJhi_600]
  have hmain : termBound_600.mem ((c .t600 * 30) * ((x 0 ^ 4) * (x 1 ^ 5))) := by
    refine mem_mul_of_bounds hcI hJmem ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
    all_goals
      simp only [I_600, J_600, termBound_600]
      rw [Rat.le_iff]
      norm_num [qIlo_600, qIhi_600, qJlo_600, qJhi_600]
  simpa using hmain

