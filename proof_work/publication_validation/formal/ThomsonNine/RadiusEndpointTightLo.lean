    (mem_const (1-point^2 : ℚ)) (by decide +kernel) (by decide +kernel) (by decide +kernel)
  simpa only [Rat.cast_sub, Rat.cast_add, Rat.cast_mul, Rat.cast_pow, Rat.cast_ofNat, Rat.cast_one] using h

