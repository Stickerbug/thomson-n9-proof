def result : RatInterval := sub (add (add (add term0 term1) term2) term3) term4
 theorem result_mem : result.mem (familyEnergyDeriv point) := by
  exact mem_sub (mem_add (mem_add (mem_add term0_mem term1_mem) term2_mem) term3_mem) term4_mem

 theorem derivative_neg : familyEnergyDeriv point < 0 := by
  have hn : result.hi < 0 := by decide +kernel
  have hn' : (result.hi : ℝ) < 0 := by exact_mod_cast hn
  exact lt_of_le_of_lt result_mem.2 hn'


