def sqrt0 : RatInterval := ⟨( /  : ℚ), ( /  : ℚ), by decide +kernel⟩
theorem sqrt0_mem : sqrt0.mem (Real.sqrt (3)) := by
  have h := mem_sqrt_of_bounds (I := const (3 : ℚ)) (K := sqrt0)
    (mem_const (3 : ℚ)) (by decide +kernel) (by decide +kernel) (by decide +kernel)
  simpa only [Rat.cast_sub, Rat.cast_add, Rat.cast_mul, Rat.cast_pow, Rat.cast_ofNat, Rat.cast_one] using h

def sqrt1 : RatInterval := ⟨( /  : ℚ), ( /  : ℚ), by decide +kernel⟩
theorem sqrt1_mem : sqrt1.mem (Real.sqrt (1-(point : ℝ)^2)) := by
