def permuted (pt : Fin 19) (σ : Fin 6) (a : Fin 3) := nodes (points pt (ActualKernel.QCache.permutation σ a))
theorem powers_valid : ∀ j a, powerCache j a=pow (nodes j) a.val := by decide +kernel
theorem q_zero : ∀ pt σ, qCache pt σ 0=[1] := by decide +kernel
theorem q_one : ∀ pt σ, qCache pt σ 1=sub (permuted pt σ 2) (mul (permuted pt σ 0) (permuted pt σ 1)) := by decide +kernel
def qStepValid (pt : Fin 19) : Prop := ∀ σ (k : Fin 9), qCache pt σ ⟨k.val+2,by omega⟩ = sub (scale 2 (mul (sub (permuted pt σ 2) (mul (permuted pt σ 0) (permuted pt σ 1))) (qCache pt σ ⟨k.val+1,by omega⟩))) (mul (mul (sub [1] (pow (permuted pt σ 0) 2)) (sub [1] (pow (permuted pt σ 1) 2))) (qCache pt σ ⟨k.val,by omega⟩))
instance (pt : Fin 19) : Decidable (qStepValid pt) := inferInstanceAs (Decidable (∀ σ (k : Fin 9), _))
def entry (k a b : Fin 11) (pt : Fin 19) : List ℚ := scale (1/6) (sum ((List.finRange 6).map (fun σ => mul (mul (powerCache (points pt (ActualKernel.QCache.permutation σ 0)) a) (powerCache (points pt (ActualKernel.QCache.permutation σ 1)) b)) (qCache pt σ k))))
def moment (k a b : Fin 11) := sum ((List.finRange 19).map (fun pt => scale (weight pt) (entry k a b pt)))
def factor (k a b : Fin 11) := add (mul (if k.val%2=0 then [1] else [1,0,-1]) (mul (ActualKernel.Syzygy.p k a) (ActualKernel.Syzygy.p k b))) (scale (1/2) (mul (ActualKernel.Syzygy.c k a) (ActualKernel.Syzygy.c k b)))
end ThomsonNine.CandidateMoment
