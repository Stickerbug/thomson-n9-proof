def numerator (k i j : Fin 11) : List ℚ := (((numerators k)[i.val]?).getD [])[j.val]?.getD []
def denValue (k : Fin 11) : ℝ := (realPolynomial (denominator k)).eval RefinedRadius.radius
def numValue (k i j : Fin 11) : ℝ := (realPolynomial (numerator k i j)).eval RefinedRadius.radius
def N (k i j : Fin 11) : ℝ := numValue k i j/denValue k

