theorem den_bounds : ∀ k : Fin 11,
    (unitScale : ℚ)*(denInterval k).lo ≤ ((horner unitScale radiusInput (denominator k)).lo : ℚ) ∧
    ((horner unitScale radiusInput (denominator k)).hi : ℚ) ≤ (unitScale : ℚ)*(denInterval k).hi := by decide +kernel
theorem den_mem (k : Fin 11) : (denInterval k).mem (denValue k) :=
  mem_to_rat (horner_mem unitScale_pos radiusInput_mem (denominator k)) unitScale_pos (den_bounds k).1 (den_bounds k).2
theorem den_sign : ∀ k : Fin 11, 0<(denInterval k).lo ∨ (denInterval k).hi<0 := by decide +kernel
theorem inverseDen_bounds : ∀ k : Fin 11,
    (inverseDenInterval k).lo ≤ 1/(denInterval k).hi ∧
    1/(denInterval k).lo ≤ (inverseDenInterval k).hi := by decide +kernel
theorem inverseDen_mem (k : Fin 11) : (inverseDenInterval k).mem ((denValue k)⁻¹) :=
  Interval.RatInterval.mem_inv_of_bounds (den_mem k) (den_sign k) (inverseDen_bounds k).1 (inverseDen_bounds k).2
theorem inverseDenInput_bounds : ∀ k : Fin 11,
    ((inverseDenInput k).lo : ℚ) ≤ (unitScale : ℚ)*(inverseDenInterval k).lo ∧
    (unitScale : ℚ)*(inverseDenInterval k).hi ≤ ((inverseDenInput k).hi : ℚ) := by decide +kernel
theorem inverseDenInput_mem (k : Fin 11) : Mem unitScale (inverseDenInput k) ((denValue k)⁻¹) :=
  mem_of_rat (inverseDen_mem k) unitScale_pos (inverseDenInput_bounds k).1 (inverseDenInput_bounds k).2

def inputN (k i j : Fin 11) : Bounds := mul unitScale (horner unitScale radiusInput (numerator k i j)) (inverseDenInput k)
theorem inputN_mem (k i j : Fin 11) : Mem unitScale (inputN k i j) (N k i j) := by
  simpa only [inputN,N,numValue,div_eq_mul_inv] using
    mem_mul unitScale_pos (horner_mem unitScale_pos radiusInput_mem (numerator k i j)) (inverseDenInput_mem k)

