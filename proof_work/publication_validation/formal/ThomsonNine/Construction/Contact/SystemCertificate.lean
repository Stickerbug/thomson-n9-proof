theorem selectedIndex_spec : ∀ h : Fin 190, match selectedIndex h with
    | none => ∀ j : Fin 33, selectedColumns j≠h
    | some j => selectedColumns j=h := by
  intro h
  cases he : selectedIndex h with
  | none => exact selectedIndex_none h he
  | some j => exact selectedIndex_some h j he
def Xinput (h : Fin 190) : Bounds := match selectedIndex h with
