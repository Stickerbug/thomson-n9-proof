    rw [Xinput,he,X,SelectedSolve.augment_unselected _ _ _ h hi]
    exact seedInput_mem h
  | some j =>
    simp only [he] at hi
    rw [Xinput,he]
    have hx : X h=(seed h : ℝ)+delta j := by
      rw [← hi,X,SelectedSolve.augment_selected _ _ selectedColumns_injective]
