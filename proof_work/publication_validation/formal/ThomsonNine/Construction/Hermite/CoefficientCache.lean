theorem fields : ∀ n : Fin 28,
    (input n).lo=((Coefficients.fixedCoefficients[n.val]?).getD zero).lo ∧
    (input n).hi=((Coefficients.fixedCoefficients[n.val]?).getD zero).hi := by decide +kernel
theorem input_mem (n : Fin 28) : Mem unitScale (input n) (H.coeff n) := by
  have hh := Coefficients.fixed_coefficient_mem n
  change ((input n).lo : ℝ)≤(unitScale : ℝ)*H.coeff n ∧ (unitScale : ℝ)*H.coeff n≤(input n).hi
  rw [(fields n).1,(fields n).2]
  exact hh
def coefficientInput (n : ℕ) : Bounds := if hn : n<28 then input ⟨n,hn⟩ else zero
theorem coefficient_mem (n : ℕ) : Mem unitScale (coefficientInput n) (H.coeff n) := by
  by_cases hn : n<28
  · simpa only [coefficientInput,dif_pos hn] using input_mem ⟨n,hn⟩
  · have hz : H.coeff n=0 := Polynomial.coeff_eq_zero_of_natDegree_lt (H_natDegree.trans_lt (by omega))
    simpa only [coefficientInput,dif_neg hn,hz] using mem_zero unitScale
