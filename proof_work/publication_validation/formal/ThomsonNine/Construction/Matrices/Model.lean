theorem indices_symmetric : ∀ k i j : Fin 11, indices k i j=indices k j i := by decide +kernel
def reduced (X : Fin 190 → ℝ) (k : Fin 11) : Matrix (Fin (reducedDim k)) (Fin (reducedDim k)) ℝ :=
  fun i j => X (indices k (reducedIndex k i) (reducedIndex k j))
theorem reduced_symmetric (X : Fin 190 → ℝ) (k : Fin 11) : ∀ i j, reduced X k i j=reduced X k j i := by
  intro i j
  simp only [reduced,indices_symmetric k (reducedIndex k i) (reducedIndex k j)]
def N (k : Fin 11) : Matrix (Fin (ambientDim k)) (Fin (reducedDim k)) ℝ :=
  fun i j => ActualKernel.N k (reducedIndex k j) (ambientIndex k i)
def A (X : Fin 190 → ℝ) (k : Fin 11) : Matrix (Fin (ambientDim k)) (Fin (ambientDim k)) ℝ :=
  N k*reduced X k*(N k).transpose
theorem A_psd (X : Fin 190 → ℝ) (k : Fin 11) (hB : (reduced X k).PosSemidef) : (A X k).PosSemidef :=
  Semantics.reduced_matrix_psd hB (N k)
