  · simpa [curvatureInput,oneInput,GramGraph.curvature,GramGraph.curvatureVT,Matrix.of_apply,Matrix.cons_val_zero,Matrix.cons_val_one,div_eq_mul_inv] using
      mem_subtract (mem_constant LocalShift.scale 1) (mem_mul LocalShift.scale_pos (mem_mul LocalShift.scale_pos (source_mem 1 hv) (source_mem 2 ht)) hiS)
  · simpa [curvatureInput,oneInput,GramGraph.curvature,GramGraph.curvatureVV,Matrix.of_apply,Matrix.cons_val_zero,Matrix.cons_val_one,div_eq_mul_inv,GramGraph.radical_swap t v] using mem_mul LocalShift.scale_pos hA hiB
theorem J_mem {v t : ℝ} (hv : (sourceBox 1).mem v) (ht : (sourceBox 2).mem t) (a : Fin 3) (b : Fin 2) :
