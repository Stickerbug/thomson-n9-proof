  have h := mem_mul LocalShift.scale_pos (AB_mem hv ht).1 (AB_mem hv ht).2
  exact sqrt_mem LocalShift.scale_pos radInput sqrtInput h sqrt_bounds.1 sqrt_bounds.2.1
    sqrt_bounds.2.2.1 sqrt_bounds.2.2.2.1 sqrt_bounds.2.2.2.2
theorem slope_mem {v t : ℝ} (hv : (sourceBox 1).mem v) (ht : (sourceBox 2).mem t) :
