theorem AB_mem {v t : ℝ} (hv : (sourceBox 1).mem v) (ht : (sourceBox 2).mem t) :
    Mem LocalShift.scale AInput (1-v^2) ∧ Mem LocalShift.scale BInput (1-t^2) := by
  constructor
  · simpa only [AInput,BInput,oneInput,pow_two,Int.cast_one] using mem_subtract (mem_constant LocalShift.scale 1)
      (mem_mul LocalShift.scale_pos (source_mem 1 hv) (source_mem 1 hv))
  · simpa only [AInput,BInput,oneInput,pow_two,Int.cast_one] using mem_subtract (mem_constant LocalShift.scale 1)
      (mem_mul LocalShift.scale_pos (source_mem 2 ht) (source_mem 2 ht))
theorem radical_mem {v t : ℝ} (hv : (sourceBox 1).mem v) (ht : (sourceBox 2).mem t) :
