  · simpa [JInput,oneInput,GramGraph.jacobian] using mem_constant LocalShift.scale 1
  · exact mem_zero LocalShift.scale
  · exact mem_zero LocalShift.scale
  · simpa [JInput,oneInput,GramGraph.jacobian] using mem_constant LocalShift.scale 1
def graphHessianInput : Fin 2 → Fin 2 → Bounds := fun i j =>
  add (matrixMulOver3 LocalShift.scale
    (matrixMulOver3 LocalShift.scale (fun a b => JInput b a) hessianCache) JInput i j)
    (mul LocalShift.scale (gradientCache 0) (curvatureInput i j))
theorem graph_hessian_bounds : ∀ i j, Contains (PSD0.matrix i j) (graphHessianInput i j) := by
  unfold Contains
  decide +kernel
theorem graph_hessian_symmetric : ∀ i j, PSD0.matrix i j=PSD0.matrix j i := by
  intro i j
  apply congrArg₂ Bounds.mk <;> fin_cases i <;> fin_cases j <;> rfl
theorem graph_hessian_mem {v t : ℝ} (hv : (sourceBox 1).mem v) (ht : (sourceBox 2).mem t)
    (x : Fin 3 → ℝ) (hx : ∀ a, (relativeBox a).mem (x a)) (i j : Fin 2) :
    Mem LocalShift.scale (PSD0.matrix i j)
      (GramGraph.hessian (fun a b => formalHessianEntry Entry.exp (fun E => coefficient E.index) a b x entries)
        (formalDerivative Entry.exp (fun E => coefficient E.index) 0 x entries) v t i j) := by
  apply mem_contains (graph_hessian_bounds i j)
  apply mem_add
  · exact matrixMulOver3_mem LocalShift.scale_pos _ _ _ _
      (fun a b => matrixMulOver3_mem LocalShift.scale_pos _ _ _ _ (fun a b => J_mem hv ht b a)
        (fun a b => formal_hessian_mem a b x hx) a b) (J_mem hv ht) i j
  · exact mem_mul LocalShift.scale_pos (formal_gradient_mem 0 x hx) (curvature_mem hv ht i j)
theorem graph_directional_nonnegative {v t : ℝ} (hv : (sourceBox 1).mem v) (ht : (sourceBox 2).mem t)
    (x : Fin 3 → ℝ) (hx : ∀ a, (relativeBox a).mem (x a)) (w : Fin 2 → ℝ) :
    0≤∑ i : Fin 2, ∑ j : Fin 2,
      GramGraph.hessian (fun a b => formalHessianEntry Entry.exp (fun E => coefficient E.index) a b x entries)
        (formalDerivative Entry.exp (fun E => coefficient E.index) 0 x entries) v t i j*w j*w i :=
  LocalQuadratic2.nonnegative_of_certificate PSD0.matrix graph_hessian_symmetric PSD0.certificate _
    (graph_hessian_mem hv ht x hx) w
