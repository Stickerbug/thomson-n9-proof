    simp [expandedCoefficient, shiftFactor]
    have hc : Nat.choose 7 5 = 21 := by decide
    rw [hc]
    ring_nf
  have he3 : expandedCoefficient (exponents .t245) (exponents .t215) (c .t245) a = ((((56 * c .t245) * a 1) * a 1) * a 1) := by
