      (fun t => decide (∀ i, exponents .t215 i ≤ exponents t i)) = [.t215, .t225, .t235, .t245, .t255] := by
    rfl
  rw [ThomsonNine.GatheredBinding.gathered, hf]
  simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, add_zero]
