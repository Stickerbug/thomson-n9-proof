/-- The unit parameter interval `[0,1]`, the base box of every local class. -/
def unitInterval : RatInterval := ⟨0, 1, by norm_num⟩

theorem unitInterval_lo : 0 ≤ unitInterval.lo := by norm_num [unitInterval]
theorem unitInterval_hi : unitInterval.hi ≤ 1 := by norm_num [unitInterval]

/-- Endpoint packaging used when instantiating `LocalCert`. -/
theorem unitInterval_bounds : 0 ≤ unitInterval.lo ∧ unitInterval.hi ≤ 1 :=
  ⟨unitInterval_lo, unitInterval_hi⟩

/-- A point interval, the building block of coefficient boxes. -/
def pointInterval (q : ℚ) : RatInterval := ⟨q, q, le_rfl⟩

theorem pointInterval_lo (q : ℚ) : (pointInterval q).lo = q := rfl
theorem pointInterval_hi (q : ℚ) : (pointInterval q).hi = q := rfl
theorem mem_pointInterval (q : ℚ) : (pointInterval q).mem (q : ℝ) :=
  ⟨le_rfl, le_rfl⟩
theorem pointInterval_lo_nonneg {q : ℚ} (h : 0 ≤ q) : 0 ≤ (pointInterval q).lo := h

end RatInterval
end Interval
