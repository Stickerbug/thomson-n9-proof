      simp only [J_696, J01_696, powerTable, finitePower, power_06, power_01, power_05]
      rw [Rat.le_iff]
      norm_num [qJlo_696, qJhi_696, qJ01lo_696, qJ01hi_696]
  have hmain : termBound_696.mem ((c .t696 * 56) * ((x 0 ^ 6) * (x 1 ^ 1) * (x 2 ^ 5))) := by
    refine mem_mul_of_bounds hcI hJmem ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
