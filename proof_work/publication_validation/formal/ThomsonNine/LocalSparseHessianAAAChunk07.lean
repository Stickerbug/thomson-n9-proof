private theorem term_mem_696 (c : TermIndex → ℝ) (x : Fin 3 → ℝ)
    (hC : ∀ k, (coefficientInterval k).mem (c k))
    (hP : PowerEnclosures (fun _ n => powerTable n) x) :
    termBound_696.mem (hessianTerm c x .t696) := by
  have hterm : hessianTerm c x .t696 =
      (c .t696 * 56) * ((x 0 ^ 6) * (x 1 ^ 1) * (x 2 ^ 5)) := by
    unfold hessianTerm derivativeCoeff monomial
    rw [show exponents .t696 = ![8, 1, 5] from rfl]
    norm_num [lowerExponent]
    try ring
    try simp
  rw [hterm]
  have hcI : I_696.mem (c .t696 * 56) := by
    constructor
    · have h := (hC .t696).1
      rw [show (coefficientInterval .t696).lo = qAlo_696 from rfl] at h
      norm_num [I_696, qIlo_696, qAlo_696] at h ⊢
      linarith
    · have h := (hC .t696).2
      rw [show (coefficientInterval .t696).hi = qAhi_696 from rfl] at h
      norm_num [I_696, qIhi_696, qAhi_696] at h ⊢
      linarith
  have hJ01 : J01_696.mem ((x 0 ^ 6) * (x 1 ^ 1)) := by
    refine mem_mul_of_bounds (by simpa using hP 0 6) (by simpa using hP 1 1) ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
