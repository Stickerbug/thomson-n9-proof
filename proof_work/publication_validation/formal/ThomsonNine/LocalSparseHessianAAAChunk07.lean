      simp only [J01_696, powerTable, finitePower, power_06, power_01]
      rw [Rat.le_iff]
      norm_num [qJ01lo_696, qJ01hi_696]
  have hJmem : J_696.mem (((x 0 ^ 6) * (x 1 ^ 1)) * (x 2 ^ 5)) := by
    refine mem_mul_of_bounds hJ01 (by simpa using hP 2 5) ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
