theorem target_0_9_10_interval_bound (c1 c2 a1 : ℝ)
    (h1 : R1.mem c1) (h2 : R2.mem c2) (ha : A1.mem a1) :
    Q.mem (c1 + (10 * c2) * a1) := by
  have hP : P.mem (10 * c2) := by
    refine mem_mul_of_bounds (mem_const (10 : ℚ)) h2 ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;>
      (simp only [P, R2, RatInterval.const]; rw [Rat.le_iff]; norm_num)
  have hK : K2.mem ((10 * c2) * a1) := by
    refine mem_mul_of_bounds hP ha ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ <;>
      (simp only [P, K2, A1]; rw [Rat.le_iff]; norm_num)
  have hJ : (add R1 K2).mem (c1 + (10 * c2) * a1) := mem_add h1 hK
  refine mem_subset hJ ?_ ?_
  · change Q.lo ≤ R1.lo + K2.lo
    rw [Rat.le_iff]
    norm_num [Q, R1, K2]
  · change R1.hi + K2.hi ≤ Q.hi
    rw [Rat.le_iff]
    norm_num [Q, R1, K2]

/-- The archived coefficient interval at exponent `(0,9,10)` is `.t126`. -/
theorem target_t126_interval_bound (c1 c2 a1 : ℝ)
    (h1 : R1.mem c1) (h2 : R2.mem c2) (ha : A1.mem a1) :
    (coefficientInterval .t126).mem (c1 + (10 * c2) * a1) := by
  have hQ : coefficientInterval .t126 = Q := rfl
  rw [hQ]
  exact target_0_9_10_interval_bound c1 c2 a1 h1 h2 ha

