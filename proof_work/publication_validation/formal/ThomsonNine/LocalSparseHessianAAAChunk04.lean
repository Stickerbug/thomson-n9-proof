private theorem term_mem_408 (c : TermIndex → ℝ) (x : Fin 3 → ℝ)
    (hC : ∀ k, (coefficientInterval k).mem (c k))
    (hP : PowerEnclosures (fun _ n => powerTable n) x) :
    termBound_408.mem (hessianTerm c x .t408) := by
  have hterm : hessianTerm c x .t408 =
      (c .t408 * 6) * ((x 0 ^ 1) * (x 1 ^ 7) * (x 2 ^ 2)) := by
    unfold hessianTerm derivativeCoeff monomial
    rw [show exponents .t408 = ![3, 7, 2] from rfl]
    norm_num [lowerExponent]
    try ring
