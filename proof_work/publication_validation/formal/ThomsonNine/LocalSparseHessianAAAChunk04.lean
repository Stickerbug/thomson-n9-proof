  have hJmem : J_408.mem (((x 0 ^ 1) * (x 1 ^ 7)) * (x 2 ^ 2)) := by
    refine mem_mul_of_bounds hJ01 (by simpa using hP 2 2) ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
