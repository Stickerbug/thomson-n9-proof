private theorem term_mem_288 (c : TermIndex → ℝ) (x : Fin 3 → ℝ)
    (hC : ∀ k, (coefficientInterval k).mem (c k))
    (hP : PowerEnclosures (fun _ n => powerTable n) x) :
    termBound_288.mem (hessianTerm c x .t288) := by
  have hterm : hessianTerm c x .t288 =
      (c .t288 * 2) * ((x 1 ^ 3) * (x 2 ^ 1)) := by
    unfold hessianTerm derivativeCoeff monomial
    rw [show exponents .t288 = ![2, 3, 1] from rfl]
    norm_num [lowerExponent]
    try ring
    try simp
  rw [hterm]
  have hcI : I_288.mem (c .t288 * 2) := by
    constructor
    · have h := (hC .t288).1
      rw [show (coefficientInterval .t288).lo = qAlo_288 from rfl] at h
      norm_num [I_288, qIlo_288, qAlo_288] at h ⊢
      linarith
    · have h := (hC .t288).2
      rw [show (coefficientInterval .t288).hi = qAhi_288 from rfl] at h
      norm_num [I_288, qIhi_288, qAhi_288] at h ⊢
      linarith
