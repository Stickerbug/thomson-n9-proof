    refine mem_mul_of_bounds hcI hJmem ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
    all_goals
      simp only [I_288, J_288, termBound_288]
      rw [Rat.le_iff]
      norm_num [qIlo_288, qIhi_288, qJlo_288, qJhi_288]
  simpa using hmain

