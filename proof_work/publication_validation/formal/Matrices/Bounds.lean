def Ainput (k : Fin 11) (a b : Fin (ambientDim k)) : Bounds :=
  ((((Acolumns k)[a.val]?).getD [])[b.val]?).getD zero
def rawAinput (k : Fin 11) (a b : Fin (ambientDim k)) : Bounds :=
  sumFin (fun i : Fin (reducedDim k) => mul unitScale (NInput k a i) (BNinput k i b))
theorem Ainput_bounds : ∀ k : Fin 11, ∀ a b : Fin (ambientDim k),
    Contains (Ainput k a b) (rawAinput k a b) := by unfold Contains; decide +kernel
theorem A_mem (X : Fin 190 → ℝ) (hX : ∀ h, Mem unitScale (solutionInput h) (X h))
    (k : Fin 11) (a b : Fin (ambientDim k)) : Mem unitScale (Ainput k a b) (A X k a b) := by
  have hh := sumFin_mem (fun i : Fin (reducedDim k) => mul unitScale (NInput k a i) (BNinput k i b))
    (fun i => N k a i*BN X k i b)
    (fun i => mem_mul unitScale_pos (NInput_mem k a i) (BN_mem X hX k i b))
  have h := mem_contains (Ainput_bounds k a b) hh
  have he : A X k=N k*BN X k := Matrix.mul_assoc (N k) (reduced X k) (N k).transpose
  rw [he,Matrix.mul_apply]
  exact h
end ThomsonNine.CertificateMatrices
