def BNinput (k : Fin 11) (i : Fin (reducedDim k)) (a : Fin (ambientDim k)) : Bounds :=
  ((((BNcolumns k)[i.val]?).getD [])[a.val]?).getD zero
def rawBNinput (k : Fin 11) (i : Fin (reducedDim k)) (a : Fin (ambientDim k)) : Bounds :=
  sumFin (fun j : Fin (reducedDim k) => mul unitScale (reducedInput k i j) (NInput k a j))
theorem BNinput_bounds : ∀ k : Fin 11, ∀ i : Fin (reducedDim k), ∀ a : Fin (ambientDim k),
    Contains (BNinput k i a) (rawBNinput k i a) := by unfold Contains; decide +kernel
def BN (X : Fin 190 → ℝ) (k : Fin 11) : Matrix (Fin (reducedDim k)) (Fin (ambientDim k)) ℝ :=
  reduced X k*(N k).transpose
theorem BN_mem (X : Fin 190 → ℝ) (hX : ∀ h, Mem unitScale (solutionInput h) (X h))
    (k : Fin 11) (i : Fin (reducedDim k)) (a : Fin (ambientDim k)) :
    Mem unitScale (BNinput k i a) (BN X k i a) := by
  have hh := sumFin_mem (fun j : Fin (reducedDim k) => mul unitScale (reducedInput k i j) (NInput k a j))
    (fun j => reduced X k i j*N k a j)
    (fun j => mem_mul unitScale_pos (reduced_mem X hX k i j) (NInput_mem k a j))
  exact mem_contains (BNinput_bounds k i a) hh
