import ThomsonNine.Construction.Algebra.IntervalPSD
import ThomsonNine.Construction.LocalShift.Inputs

-- Isolated source: LocalBoundary.C09.PSD2
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000000
noncomputable section
namespace ThomsonNine.ActualBoundary.C09.PSD2
open ThomsonNine.FixedInterval ThomsonNine.FixedInterval.Schur
def matrix : Fin 0 → Fin 0 → Bounds := Fin.elim0
theorem certificate : PSDSound LocalShift.scale matrix := empty_psdSound LocalShift.scale matrix
end ThomsonNine.ActualBoundary.C09.PSD2

end

