theorem diagonalInput_fields : ∀ n : Fin 28,
    (diagonalInput n).lo=(FixedInterval.sum ((diagonalIndices n).map ActualF.Cached.input)).lo ∧
    (diagonalInput n).hi=(FixedInterval.sum ((diagonalIndices n).map ActualF.Cached.input)).hi := by decide +kernel
theorem diagonalIndices_filter : ∀ n : Fin 28, diagonalIndices n=
    (List.finRange 756).filter (fun j => decide (ActualF.Data.support j 1+ActualF.Data.support j 2=n.val)) := by decide +kernel
end ThomsonNine.ActualR.Data
