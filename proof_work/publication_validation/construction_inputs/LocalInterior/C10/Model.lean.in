⟨(-1552518092300708935148979488462502555256886017116696611139052038026050952686376886330878408828646477956684685750424224701068876524055557524438597897503),1552518092300708935148979488462502555256886017116696611139052038026050952686376886330878408828646477956862014075040856914444329537354091161349023390331⟩]]
theorem power_fields : ∀ a (n : Fin 28), (powerCache a n).lo=(power LocalShift.scale (domain a) n.val).lo ∧ (powerCache a n).hi=(power LocalShift.scale (domain a) n.val).hi := by decide +kernel
def powers (a : Fin 3) (n : ℕ) : Bounds := if h:n<28 then powerCache a ⟨n,h⟩ else power LocalShift.scale (domain a) n
theorem powers_mem (a : Fin 3) {x : ℝ} (hx : (relativeBox a).mem x) (n : ℕ) :
    Mem LocalShift.scale (powers a n) (x^n) := by
  have hd := mem_of_rat hx LocalShift.scale_pos (domain_bounds a).1 (domain_bounds a).2
  by_cases hn : n<28
  · have he : powerCache a ⟨n,hn⟩=power LocalShift.scale (domain a) n :=
      congrArg₂ Bounds.mk (power_fields a ⟨n,hn⟩).1 (power_fields a ⟨n,hn⟩).2
    rw [powers,dif_pos hn,he]
    exact power_mem LocalShift.scale_pos hd n
  · rw [powers,dif_neg hn]
    exact power_mem LocalShift.scale_pos hd n
def hessianComputed (i j : Fin 3) : Bounds :=
  FixedSparseHessian.hessianInput LocalShift.scale Entry.exp (fun E => input E.index) powers i j entries
theorem hessianComputed_mem (i j : Fin 3) (x : Fin 3 → ℝ)
    (hx : ∀ a, (relativeBox a).mem (x a)) :
    Mem LocalShift.scale (hessianComputed i j)
      (Interval.SparsePolynomial.formalHessianEntry Entry.exp (fun E => coefficient E.index) i j x entries) := by
  apply FixedSparseHessian.hessianInput_mem LocalShift.scale_pos Entry.exp (fun E => input E.index)
    (fun E => coefficient E.index) powers x i j entries
  · intro E hE
    exact LocalShift.Stage10_2.output_mem E.index
  · intro a n
    exact powers_mem a (hx a) n
