theorem bounds : ∀ j : Fin 756,
    (unitScale : ℚ)*(coefficientInterval j).lo≤(Cached.input j).lo ∧
    ((Cached.input j).hi : ℚ)≤(unitScale : ℚ)*(coefficientInterval j).hi := by decide +kernel
theorem actual_coefficient_mem (j : Fin 756) : (coefficientInterval j).mem (coefficient ActualContact.SystemCertificate.X j) :=
  mem_to_rat (Cached.input_mem _ actual_X_mem j) unitScale_pos (bounds j).1 (bounds j).2
end ThomsonNine.ActualF.Refined
