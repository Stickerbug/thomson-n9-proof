def inputValue (p : Fin 19) (σ : Fin 6) (n : ℕ) : Input :=
  ((inputValues p σ)[n]?).getD (inputConstant FixedInterval.zero)
def U (p : Fin 19) (σ : Fin 6) : Jet := coordinate (point p) (permutation σ 0)
def V (p : Fin 19) (σ : Fin 6) : Jet := coordinate (point p) (permutation σ 1)
def T (p : Fin 19) (σ : Fin 6) : Jet := coordinate (point p) (permutation σ 2)
def IU (p : Fin 19) (σ : Fin 6) : Input := inputCoordinate unitScale (inputPoint p) (permutation σ 0)
def IV (p : Fin 19) (σ : Fin 6) : Input := inputCoordinate unitScale (inputPoint p) (permutation σ 1)
def IT (p : Fin 19) (σ : Fin 6) : Input := inputCoordinate unitScale (inputPoint p) (permutation σ 2)
def step (p : Fin 19) (σ : Fin 6) (k : ℕ) : Input :=
  inputSubtract
    (inputMul unitScale (inputMul unitScale (inputConstant (FixedInterval.constant unitScale 2))
      (inputSubtract (IT p σ) (inputMul unitScale (IU p σ) (IV p σ)))) (inputValue p σ (k+1)))
    (inputMul unitScale (inputMul unitScale
      (inputSubtract (inputConstant (FixedInterval.constant unitScale 1)) (inputMul unitScale (IU p σ) (IU p σ)))
      (inputSubtract (inputConstant (FixedInterval.constant unitScale 1)) (inputMul unitScale (IV p σ) (IV p σ)))) (inputValue p σ k))
theorem zero_bounds : ∀ p : Fin 19, ∀ σ : Fin 6,
    Contains (inputValue p σ 0) (inputConstant (FixedInterval.constant unitScale 1)) := by
  unfold Contains FixedInterval.Schur.Contains
  decide +kernel
theorem one_bounds : ∀ p : Fin 19, ∀ σ : Fin 6,
    Contains (inputValue p σ 1) (inputSubtract (IT p σ) (inputMul unitScale (IU p σ) (IV p σ))) := by
  unfold Contains FixedInterval.Schur.Contains
  decide +kernel
def StepBound (p : Fin 19) : Prop := ∀ σ : Fin 6, ∀ k : Fin 9,
    Contains (inputValue p σ (k.val+2)) (step p σ k.val)
theorem step00 : StepBound 0 := by unfold StepBound Contains FixedInterval.Schur.Contains; decide +kernel
theorem step01 : StepBound 1 := by unfold StepBound Contains FixedInterval.Schur.Contains; decide +kernel
