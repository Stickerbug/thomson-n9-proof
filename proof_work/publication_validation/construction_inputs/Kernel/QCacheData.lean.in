theorem step_bounds (p : Fin 19) : StepBound p := by
  fin_cases p
  · exact step00
  · exact step01
  · exact step02
  · exact step03
  · exact step04
  · exact step05
  · exact step06
  · exact step07
  · exact step08
  · exact step09
  · exact step10
  · exact step11
  · exact step12
  · exact step13
  · exact step14
  · exact step15
  · exact step16
  · exact step17
  · exact step18
end ThomsonNine.ActualKernel.QCache
