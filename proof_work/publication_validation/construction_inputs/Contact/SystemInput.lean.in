theorem residual_bounds (i : Fin 33) : Contains (ContactSchur.Stage00.b i) (residualInput i) := by
  fin_cases i
  · exact residual_bounds00
  · exact residual_bounds01
  · exact residual_bounds02
  · exact residual_bounds03
  · exact residual_bounds04
  · exact residual_bounds05
  · exact residual_bounds06
  · exact residual_bounds07
  · exact residual_bounds08
  · exact residual_bounds09
