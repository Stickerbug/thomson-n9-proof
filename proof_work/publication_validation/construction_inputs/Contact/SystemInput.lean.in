theorem seedInput_bounds : ∀ h : Fin 190,
    ((seedInput h).lo : ℚ)≤(unitScale : ℚ)*seed h ∧ (unitScale : ℚ)*seed h≤(seedInput h).hi := by decide +kernel
theorem seedInput_mem (h : Fin 190) : Mem unitScale (seedInput h) (seed h : ℝ) :=
  mem_of_rat (Interval.RatInterval.mem_const (seed h)) unitScale_pos (seedInput_bounds h).1 (seedInput_bounds h).2
def A (i j : Fin 33) : ℝ := M (selectedRows (permutation i)) (selectedColumns j)
def rhsResidual (i : Fin 33) : ℝ :=
  rhs (selectedRows (permutation i))-∑ h : Fin 190, M (selectedRows (permutation i)) h*(seed h : ℝ)
def residualInput (i : Fin 33) : Bounds := Schur.subtract (inputRhs (selectedRows (permutation i)))
  (sumFin (fun h : Fin 190 => mul unitScale (CachedRows.matrix (permutation i) h) (seedInput h)))
theorem input_matrix_bounds : ∀ i j : Fin 33,
    Contains (ContactSchur.Stage00.A i j) (CachedRows.matrix (permutation i) (selectedColumns j)) := by
  unfold Contains
  decide +kernel
theorem A_mem (i j : Fin 33) : Mem unitScale (ContactSchur.Stage00.A i j) (A i j) :=
  mem_contains (input_matrix_bounds i j) (CachedRows.matrix_mem (permutation i) (selectedColumns j))
theorem residualInput_mem (i : Fin 33) : Mem unitScale (residualInput i) (rhsResidual i) :=
  mem_subtract (rhs_mem _) (sumFin_mem _ _ (fun h =>
    mem_mul unitScale_pos (CachedRows.matrix_mem (permutation i) h) (seedInput_mem h)))
theorem residual_bounds00 : Contains (ContactSchur.Stage00.b 0) (residualInput 0) := by unfold Contains; decide +kernel
