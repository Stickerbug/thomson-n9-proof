  · exact residual_bounds23
  · exact residual_bounds24
  · exact residual_bounds25
  · exact residual_bounds26
  · exact residual_bounds27
  · exact residual_bounds28
  · exact residual_bounds29
  · exact residual_bounds30
  · exact residual_bounds31
  · exact residual_bounds32

theorem residual_mem (i : Fin 33) : Mem unitScale (ContactSchur.Stage00.b i) (rhsResidual i) :=
  mem_contains (residual_bounds i) (residualInput_mem i)
