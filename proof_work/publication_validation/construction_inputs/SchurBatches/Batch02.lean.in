def inverse : Bounds := ⟨(-), (-)⟩
def pivotInterval : RatInterval := ⟨(- : ℚ), (- : ℚ), by decide +kernel⟩
def inverseInterval : RatInterval := ⟨(- : ℚ), (- : ℚ), by decide +kernel⟩

theorem inverse_rule : InverseRule unitScale (A 0 0) inverse := by
  apply inverseRule_of_rat unitScale_pos (A 0 0) inverse pivotInterval inverseInterval <;> decide +kernel

theorem next_matrix_bounds : ∀ i j : Fin 21, Contains (Stage12.A i j) (reducedMatrix unitScale A inverse i j) := by
  unfold Contains
  decide +kernel
theorem next_rhs_bounds : ∀ i : Fin 21, Contains (Stage12.b i) (reducedRhs unitScale A b inverse i) := by
  unfold Contains
  decide +kernel
theorem output_bounds : ∀ i : Fin 22, Contains (solution i) (recover unitScale A b inverse Stage12.solution i) := by
  unfold Contains
  decide +kernel

theorem certificate : Sound unitScale A b solution :=
  step_sound unitScale_pos A b solution inverse Stage12.A Stage12.b Stage12.solution
    inverse_rule next_matrix_bounds next_rhs_bounds Stage12.certificate output_bounds
end ThomsonNine.ContactSchur.Stage11

end

