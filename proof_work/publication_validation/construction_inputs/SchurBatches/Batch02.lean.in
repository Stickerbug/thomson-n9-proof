def inverse : Bounds := ⟨, ⟩
def pivotInterval : RatInterval := ⟨( : ℚ), ( : ℚ), by decide +kernel⟩
def inverseInterval : RatInterval := ⟨( : ℚ), ( : ℚ), by decide +kernel⟩

theorem inverse_rule : InverseRule unitScale (A 0 0) inverse := by
  apply inverseRule_of_rat unitScale_pos (A 0 0) inverse pivotInterval inverseInterval <;> decide +kernel

theorem next_matrix_bounds : ∀ i j : Fin 16, Contains (Stage17.A i j) (reducedMatrix unitScale A inverse i j) := by
  unfold Contains
  decide +kernel
theorem next_rhs_bounds : ∀ i : Fin 16, Contains (Stage17.b i) (reducedRhs unitScale A b inverse i) := by
  unfold Contains
  decide +kernel
theorem output_bounds : ∀ i : Fin 17, Contains (solution i) (recover unitScale A b inverse Stage17.solution i) := by
  unfold Contains
  decide +kernel

theorem certificate : Sound unitScale A b solution :=
  step_sound unitScale_pos A b solution inverse Stage17.A Stage17.b Stage17.solution
    inverse_rule next_matrix_bounds next_rhs_bounds Stage17.certificate output_bounds
end ThomsonNine.ContactSchur.Stage16

end

