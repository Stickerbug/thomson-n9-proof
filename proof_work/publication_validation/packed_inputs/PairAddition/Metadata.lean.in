theorem weights_positive : ∀ f, 0<(features f).weight := by decide +kernel
theorem denominators_positive : ∀ h, 0<denominator h := by decide +kernel
structure Contribution where
  feature : Fin 138
  power : ℕ
  weight : ℤ
  coefficients : List ℤ
  deriving DecidableEq
def Valid (h : Fin 38) (c : Contribution) : Prop :=
  2*c.power+h.val=(features c.feature).order.val ∧
  (c.weight : ℚ)=(denominator h : ℚ)*(features c.feature).weight*qCoefficient (features c.feature).order h ∧
  c.coefficients=IntegerListPolynomial.mul (features c.feature).coefficients (IntegerListPolynomial.pow [1,0,-1] c.power)
instance (h : Fin 38) (c : Contribution) : Decidable (Valid h c) := by unfold Valid;infer_instance
def matrixEntry (cs : List Contribution) (i j : Fin 38) : ℤ :=
  (cs.map (fun c => c.weight*(c.coefficients[i.val]?).getD 0*(c.coefficients[j.val]?).getD 0)).sum
end ThomsonNine.PairAddition
