theorem contributions_valid : contributions.all (fun c => decide (Valid 11 c))=true := by decide +kernel
theorem features_complete : contributions.map Contribution.feature=
    (List.finRange 138).filter (fun f => decide (11≤(features f).order.val ∧ ((features f).order.val-11)%2=0)) := by decide +kernel
