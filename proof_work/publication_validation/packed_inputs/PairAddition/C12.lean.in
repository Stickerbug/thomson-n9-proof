theorem contributions_valid : contributions.all (fun c => decide (Valid 12 c))=true := by decide +kernel
theorem features_complete : contributions.map Contribution.feature=
    (List.finRange 138).filter (fun f => decide (12≤(features f).order.val ∧ ((features f).order.val-12)%2=0)) := by decide +kernel
