theorem contributions_valid : contributions.all (fun c => decide (Valid 8 c))=true := by decide +kernel
theorem features_complete : contributions.map Contribution.feature=
    (List.finRange 138).filter (fun f => decide (8≤(features f).order.val ∧ ((features f).order.val-8)%2=0)) := by decide +kernel
