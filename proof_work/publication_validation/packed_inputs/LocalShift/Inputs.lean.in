⟨( : ℚ),( : ℚ),by decide +kernel⟩,
⟨( : ℚ),( : ℚ),by decide +kernel⟩],
![⟨( : ℚ),( : ℚ),by decide +kernel⟩,
⟨( : ℚ),( : ℚ),by decide +kernel⟩,
⟨( : ℚ),( : ℚ),by decide +kernel⟩],
![⟨(- : ℚ),(- : ℚ),by decide +kernel⟩,
⟨(- : ℚ),(- : ℚ),by decide +kernel⟩,
⟨( : ℚ),( : ℚ),by decide +kernel⟩],
![⟨(- : ℚ),(- : ℚ),by decide +kernel⟩,
⟨( : ℚ),( : ℚ),by decide +kernel⟩,
⟨( : ℚ),( : ℚ),by decide +kernel⟩],
![⟨(- : ℚ),(- : ℚ),by decide +kernel⟩,
⟨(- : ℚ),(- : ℚ),by decide +kernel⟩,
⟨( : ℚ),( : ℚ),by decide +kernel⟩],
![⟨(-1/2 : ℚ),(-1/2 : ℚ),by decide +kernel⟩,
⟨(-1/2 : ℚ),(-1/2 : ℚ),by decide +kernel⟩,
⟨(-1/2 : ℚ),(-1/2 : ℚ),by decide +kernel⟩],
![⟨(-1/2 : ℚ),(-1/2 : ℚ),by decide +kernel⟩,
⟨( : ℚ),( : ℚ),by decide +kernel⟩,
⟨( : ℚ),( : ℚ),by decide +kernel⟩],
![⟨(- : ℚ),(- : ℚ),by decide +kernel⟩,
⟨(-1/2 : ℚ),(-1/2 : ℚ),by decide +kernel⟩,
⟨( : ℚ),( : ℚ),by decide +kernel⟩]]
theorem node_to_center_bounds : ∀ localId axis,
    (ActualHermite.CoefficientData.unitScale : ℚ)*(centerInterval localId axis).lo≤(ActualHermite.CoefficientData.inputNode (labels localId axis)).lo ∧
    (ActualHermite.CoefficientData.inputNode (labels localId axis)).hi≤(ActualHermite.CoefficientData.unitScale : ℚ)*(centerInterval localId axis).hi := by decide +kernel

theorem center_rounding_bounds : ∀ localId axis,
    ((centerInput localId axis).lo : ℚ)≤(scale : ℚ)*(centerInterval localId axis).lo ∧
    (scale : ℚ)*(centerInterval localId axis).hi≤((centerInput localId axis).hi : ℚ) := by decide +kernel

theorem center_mem (localId : Fin 12) (axis : Fin 3) : Mem scale (centerInput localId axis) (center localId axis) := by
  have h := mem_to_rat (ActualHermite.CoefficientData.inputNode_mem (labels localId axis))
    ActualHermite.CoefficientData.unitScale_pos (node_to_center_bounds localId axis).1 (node_to_center_bounds localId axis).2
  exact mem_of_rat h scale_pos (center_rounding_bounds localId axis).1 (center_rounding_bounds localId axis).2

theorem source_mem (t : TermIndex) : Mem scale (AAAFixedData.source t) (ActualR.family t) :=
  mem_of_rat (ActualR.Certified.family_mem t) scale_pos
    (AAAFixedData.source_bounds t (AAAGroupedData.allTerms_complete t)).1
    (AAAFixedData.source_bounds t (AAAGroupedData.allTerms_complete t)).2

def family1 (localId : Fin 12) : TermIndex → ℝ := step 0 (center localId 0) ActualR.family
def family2 (localId : Fin 12) : TermIndex → ℝ := step 1 (center localId 1) (family1 localId)
def family3 (localId : Fin 12) : TermIndex → ℝ := step 2 (center localId 2) (family2 localId)

theorem family3_eval (localId : Fin 12) (x : Fin 3 → ℝ) :
    Interval.SparsePolynomial.eval exponents (family3 localId) x GatheredBinding.allTerms=
      ActualR.residual (fun axis => center localId axis+x axis) := by
  rw [family3,step_eval,family2,step_eval,family1,step_eval]
  have he : Function.update (Function.update (Function.update x 2 (center localId 2+x 2))
      1 (center localId 1+(Function.update x 2 (center localId 2+x 2)) 1))
      0 (center localId 0+(Function.update (Function.update x 2 (center localId 2+x 2))
        1 (center localId 1+(Function.update x 2 (center localId 2+x 2)) 1)) 0)=
      (fun axis => center localId axis+x axis) := by
    funext axis
    fin_cases axis <;> simp
  rw [he]
  exact congrFun ActualR.source_function_eq _
end ThomsonNine.LocalShift
