import LocalBoundary.C09.Certified
import LocalBoundary.C09.PSD0
import Algebra.FixedGraphBounds
import Algebra.GramCurve
import Algebra.HessianPSD2
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000000
noncomputable section
namespace ThomsonNine.ActualBoundary.C09
open ThomsonNine.FixedInterval ThomsonNine.FixedInterval.Schur ThomsonNine.ActualLocalAAA
open ThomsonNine.Interval.SparsePolynomial
open scoped BigOperators
attribute [local irreducible] entries
def sourceBox : Fin 3 → Interval.RatInterval := ![⟨(-1231312939899866202849215079873488557306328133950415648782425843559512581895048903464262141804317706805929879738513/2462625387274654950767440006258975862817483704404090416746768337765357610718575663213391640930307227550414249394176 : ℚ),(-1231312447374788747918224926385487305511155570453674767964342494205845028823526759749129499125989520744484369655663/2462625387274654950767440006258975862817483704404090416746768337765357610718575663213391640930307227550414249394176 : ℚ),by decide +kernel⟩,
⟨(-1231312939899866202849215079873488557306328133950415648782425843559512581895048903464262141804317706805929879738513/2462625387274654950767440006258975862817483704404090416746768337765357610718575663213391640930307227550414249394176 : ℚ),(-1231312447374788747918224926385487305511155570453674767964342494205845028823526759749129499125989520744484369655663/2462625387274654950767440006258975862817483704404090416746768337765357610718575663213391640930307227550414249394176 : ℚ),by decide +kernel⟩,
⟨(-1231312939899866202849215079873488557306328133950415648782425843559512581895048903464262141804317706805929879738513/2462625387274654950767440006258975862817483704404090416746768337765357610718575663213391640930307227550414249394176 : ℚ),(-1231312447374788747918224926385487305511155570453674767964342494205845028823526759749129499125989520744484369655663/2462625387274654950767440006258975862817483704404090416746768337765357610718575663213391640930307227550414249394176 : ℚ),by decide +kernel⟩]
def expandedBox : Fin 3 → Interval.RatInterval := ![⟨(- : ℚ),(- : ℚ),by decide +kernel⟩,
⟨(-1231312939899866202849215079873488557306328133950415648782425843559512581895048903464262141804317706805929879738513/2462625387274654950767440006258975862817483704404090416746768337765357610718575663213391640930307227550414249394176 : ℚ),(-1231312447374788747918224926385487305511155570453674767964342494205845028823526759749129499125989520744484369655663/2462625387274654950767440006258975862817483704404090416746768337765357610718575663213391640930307227550414249394176 : ℚ),by decide +kernel⟩,
⟨(-1231312939899866202849215079873488557306328133950415648782425843559512581895048903464262141804317706805929879738513/2462625387274654950767440006258975862817483704404090416746768337765357610718575663213391640930307227550414249394176 : ℚ),(-1231312447374788747918224926385487305511155570453674767964342494205845028823526759749129499125989520744484369655663/2462625387274654950767440006258975862817483704404090416746768337765357610718575663213391640930307227550414249394176 : ℚ),by decide +kernel⟩]
def sourceInput : Fin 3 → Bounds := ![⟨(-776259201402163697645383259129200123878698534246950017239187132918229278948283711803127837502164121839891660397338644509282713718397770486783086188996821831525083473189942015831168531858562178414270301221461512785706380171545673728),(-776258890898545237503596229333302431378187482869746593899864905107821673738093174527750571326482356110596070299792428696888866325717043904661201086044359307679371502830907889719096753773036266410992697972254955965186466682270384128)⟩,
⟨(-776259201402163697645383259129200123878698534246950017239187132918229278948283711803127837502164121839891660397338644509282713718397770486783086188996821831525083473189942015831168531858562178414270301221461512785706380171545673728),(-776258890898545237503596229333302431378187482869746593899864905107821673738093174527750571326482356110596070299792428696888866325717043904661201086044359307679371502830907889719096753773036266410992697972254955965186466682270384128)⟩,
⟨(-776259201402163697645383259129200123878698534246950017239187132918229278948283711803127837502164121839891660397338644509282713718397770486783086188996821831525083473189942015831168531858562178414270301221461512785706380171545673728),(-776258890898545237503596229333302431378187482869746593899864905107821673738093174527750571326482356110596070299792428696888866325717043904661201086044359307679371502830907889719096753773036266410992697972254955965186466682270384128)⟩]
theorem source_bounds : ∀ a, ((sourceInput a).lo : ℚ)≤(LocalShift.scale : ℚ)*(sourceBox a).lo ∧
    (LocalShift.scale : ℚ)*(sourceBox a).hi≤((sourceInput a).hi : ℚ) := by decide +kernel
theorem source_mem (a : Fin 3) {x : ℝ} (hx : (sourceBox a).mem x) : Mem LocalShift.scale (sourceInput a) x :=
  mem_of_rat hx LocalShift.scale_pos (source_bounds a).1 (source_bounds a).2
def oneInput : Bounds := constant LocalShift.scale 1
def AInput : Bounds := subtract oneInput (mul LocalShift.scale (sourceInput 1) (sourceInput 1))
def BInput : Bounds := subtract oneInput (mul LocalShift.scale (sourceInput 2) (sourceInput 2))
def radInput : Bounds := mul LocalShift.scale AInput BInput
def sqrtInput : Bounds := ⟨1164388413973706946109918094359576580397524362123368177824456747648223021389307135600943309764780666814129716509295692121117151408093069950250055840760058740106983274076315374753010672472813571717573563427372000862245933508420558591,1164388724477325406251705124155474272898035413500571601163778975458630626599497672876320575940462432543425306606841907933510998800773796532371940943712521263952695244435349500865082450558339483720851166676578557682765846997695848193⟩
theorem sqrt_bounds : 0≤radInput.lo ∧ 0≤sqrtInput.lo ∧ 0≤sqrtInput.hi ∧
    sqrtInput.lo^2≤LocalShift.scale*radInput.lo ∧ LocalShift.scale*radInput.hi≤sqrtInput.hi^2 := by decide +kernel
def invSInput : Bounds := ⟨2070023847064459905255279476711476582538659837355384349598654176005505784903411268063467515459434088909644578764749656337188130337559977224908445603545719997170758326340658230868342686078864387986600397893161223329379604495155283165,2070024399070892723309656704473874798948547534292586034497331218159356989245676539291233059623127136791730188188690480401650603460873150198524621127135616216322976693088057641331181855769648356728859676564949342242093010309344053511⟩
def invSInputK : Interval.RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
def invSInputL : Interval.RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
theorem invSInput_rule : InverseRule LocalShift.scale (sqrtInput) invSInput := by
  apply inverseRule_of_rat LocalShift.scale_pos (sqrtInput) invSInput invSInputK invSInputL <;> decide +kernel
def invASInput : Bounds := ⟨2760031428081792929853689745695734066483613528446261788143679765673880872417307686855230670684314097046588956329099228557379054229348320911173191521366471602947540827367402164231872404587660762450534607623030050048229268313642260927,2760032900098947111377825108969999298932756170081589826957352973057231824664786104117453492306023389238656229717607875498123968679356692480415325522354075453469607072753171621635338172977854907647560844113445301576501533250680913382⟩
def invASInputK : Interval.RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
def invASInputL : Interval.RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
theorem invASInput_rule : InverseRule LocalShift.scale (mul LocalShift.scale AInput sqrtInput) invASInput := by
  apply inverseRule_of_rat LocalShift.scale_pos (mul LocalShift.scale AInput sqrtInput) invASInput invASInputK invASInputL <;> decide +kernel
def invBSInput : Bounds := ⟨2760031428081792929853689745695734066483613528446261788143679765673880872417307686855230670684314097046588956329099228557379054229348320911173191521366471602947540827367402164231872404587660762450534607623030050048229268313642260927,2760032900098947111377825108969999298932756170081589826957352973057231824664786104117453492306023389238656229717607875498123968679356692480415325522354075453469607072753171621635338172977854907647560844113445301576501533250680913382⟩
def invBSInputK : Interval.RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
def invBSInputL : Interval.RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
theorem invBSInput_rule : InverseRule LocalShift.scale (mul LocalShift.scale BInput sqrtInput) invBSInput := by
  apply inverseRule_of_rat LocalShift.scale_pos (mul LocalShift.scale BInput sqrtInput) invBSInput invBSInputK invBSInputL <;> decide +kernel
def slopeInput : Fin 2 → Bounds := ![
  add (sourceInput 2) (mul LocalShift.scale (mul LocalShift.scale (sourceInput 1) BInput) invSInput),
  add (sourceInput 1) (mul LocalShift.scale (mul LocalShift.scale (sourceInput 2) AInput) invSInput)]
def curvatureInput : Fin 2 → Fin 2 → Bounds := !![
  mul LocalShift.scale BInput invASInput,subtract oneInput (mul LocalShift.scale (mul LocalShift.scale (sourceInput 1) (sourceInput 2)) invSInput);
  subtract oneInput (mul LocalShift.scale (mul LocalShift.scale (sourceInput 1) (sourceInput 2)) invSInput),mul LocalShift.scale AInput invBSInput]
def JInput : Fin 3 → Fin 2 → Bounds := !![slopeInput 0,slopeInput 1;oneInput,zero;zero,oneInput]
def graphInput : Bounds := subtract (mul LocalShift.scale (sourceInput 1) (sourceInput 2)) sqrtInput
theorem AB_mem {v t : ℝ} (hv : (sourceBox 1).mem v) (ht : (sourceBox 2).mem t) :
    Mem LocalShift.scale AInput (1-v^2) ∧ Mem LocalShift.scale BInput (1-t^2) := by
  constructor
  · simpa only [AInput,BInput,oneInput,pow_two,Int.cast_one] using mem_subtract (mem_constant LocalShift.scale 1)
      (mem_mul LocalShift.scale_pos (source_mem 1 hv) (source_mem 1 hv))
  · simpa only [AInput,BInput,oneInput,pow_two,Int.cast_one] using mem_subtract (mem_constant LocalShift.scale 1)
      (mem_mul LocalShift.scale_pos (source_mem 2 ht) (source_mem 2 ht))
theorem radical_mem {v t : ℝ} (hv : (sourceBox 1).mem v) (ht : (sourceBox 2).mem t) :
    Mem LocalShift.scale sqrtInput (GramGraph.radical v t) := by
  have h := mem_mul LocalShift.scale_pos (AB_mem hv ht).1 (AB_mem hv ht).2
  exact sqrt_mem LocalShift.scale_pos radInput sqrtInput h sqrt_bounds.1 sqrt_bounds.2.1
    sqrt_bounds.2.2.1 sqrt_bounds.2.2.2.1 sqrt_bounds.2.2.2.2
theorem slope_mem {v t : ℝ} (hv : (sourceBox 1).mem v) (ht : (sourceBox 2).mem t) :
    Mem LocalShift.scale (slopeInput 0) (GramGraph.slope v t) ∧
      Mem LocalShift.scale (slopeInput 1) (GramGraph.slope t v) := by
  have hi := (invSInput_rule _ (radical_mem hv ht)).2
  constructor
  · simpa [slopeInput,GramGraph.slope,div_eq_mul_inv] using mem_add (source_mem 2 ht)
      (mem_mul LocalShift.scale_pos (mem_mul LocalShift.scale_pos (source_mem 1 hv) (AB_mem hv ht).2) hi)
  · simpa [slopeInput,GramGraph.slope,div_eq_mul_inv,GramGraph.radical_swap t v] using mem_add (source_mem 1 hv)
      (mem_mul LocalShift.scale_pos (mem_mul LocalShift.scale_pos (source_mem 2 ht) (AB_mem hv ht).1) hi)
theorem curvature_mem {v t : ℝ} (hv : (sourceBox 1).mem v) (ht : (sourceBox 2).mem t) (a b : Fin 2) :
    Mem LocalShift.scale (curvatureInput a b) (GramGraph.curvature v t a b) := by
  have hA := (AB_mem hv ht).1
  have hB := (AB_mem hv ht).2
  have hS := radical_mem hv ht
  have hiS := (invSInput_rule _ hS).2
  have hiA := (invASInput_rule _ (mem_mul LocalShift.scale_pos hA hS)).2
  have hiB := (invBSInput_rule _ (mem_mul LocalShift.scale_pos hB hS)).2
  fin_cases a <;> fin_cases b
  · simpa [curvatureInput,oneInput,GramGraph.curvature,GramGraph.curvatureVV,Matrix.of_apply,Matrix.cons_val_zero,div_eq_mul_inv] using mem_mul LocalShift.scale_pos hB hiA
  · simpa [curvatureInput,oneInput,GramGraph.curvature,GramGraph.curvatureVT,Matrix.of_apply,Matrix.cons_val_zero,Matrix.cons_val_one,div_eq_mul_inv] using
      mem_subtract (mem_constant LocalShift.scale 1) (mem_mul LocalShift.scale_pos (mem_mul LocalShift.scale_pos (source_mem 1 hv) (source_mem 2 ht)) hiS)
  · simpa [curvatureInput,oneInput,GramGraph.curvature,GramGraph.curvatureVT,Matrix.of_apply,Matrix.cons_val_zero,Matrix.cons_val_one,div_eq_mul_inv] using
      mem_subtract (mem_constant LocalShift.scale 1) (mem_mul LocalShift.scale_pos (mem_mul LocalShift.scale_pos (source_mem 1 hv) (source_mem 2 ht)) hiS)
  · simpa [curvatureInput,oneInput,GramGraph.curvature,GramGraph.curvatureVV,Matrix.of_apply,Matrix.cons_val_zero,Matrix.cons_val_one,div_eq_mul_inv,GramGraph.radical_swap t v] using mem_mul LocalShift.scale_pos hA hiB
theorem J_mem {v t : ℝ} (hv : (sourceBox 1).mem v) (ht : (sourceBox 2).mem t) (a : Fin 3) (b : Fin 2) :
    Mem LocalShift.scale (JInput a b) (GramGraph.jacobian v t a b) := by
  fin_cases a <;> fin_cases b
  · exact (slope_mem hv ht).1
  · exact (slope_mem hv ht).2
  · simpa [JInput,oneInput,GramGraph.jacobian] using mem_constant LocalShift.scale 1
  · exact mem_zero LocalShift.scale
  · exact mem_zero LocalShift.scale
  · simpa [JInput,oneInput,GramGraph.jacobian] using mem_constant LocalShift.scale 1
def graphHessianInput : Fin 2 → Fin 2 → Bounds := fun i j =>
  add (matrixMulOver3 LocalShift.scale
    (matrixMulOver3 LocalShift.scale (fun a b => JInput b a) hessianCache) JInput i j)
    (mul LocalShift.scale (gradientCache 0) (curvatureInput i j))
theorem graph_hessian_bounds : ∀ i j, Contains (PSD0.matrix i j) (graphHessianInput i j) := by
  unfold Contains
  decide +kernel
theorem graph_hessian_symmetric : ∀ i j, PSD0.matrix i j=PSD0.matrix j i := by
  intro i j
  apply congrArg₂ Bounds.mk <;> fin_cases i <;> fin_cases j <;> rfl
theorem graph_hessian_mem {v t : ℝ} (hv : (sourceBox 1).mem v) (ht : (sourceBox 2).mem t)
    (x : Fin 3 → ℝ) (hx : ∀ a, (relativeBox a).mem (x a)) (i j : Fin 2) :
    Mem LocalShift.scale (PSD0.matrix i j)
      (GramGraph.hessian (fun a b => formalHessianEntry Entry.exp (fun E => coefficient E.index) a b x entries)
        (formalDerivative Entry.exp (fun E => coefficient E.index) 0 x entries) v t i j) := by
  apply mem_contains (graph_hessian_bounds i j)
  apply mem_add
  · exact matrixMulOver3_mem LocalShift.scale_pos _ _ _ _
      (fun a b => matrixMulOver3_mem LocalShift.scale_pos _ _ _ _ (fun a b => J_mem hv ht b a)
        (fun a b => formal_hessian_mem a b x hx) a b) (J_mem hv ht) i j
  · exact mem_mul LocalShift.scale_pos (formal_gradient_mem 0 x hx) (curvature_mem hv ht i j)
theorem graph_directional_nonnegative {v t : ℝ} (hv : (sourceBox 1).mem v) (ht : (sourceBox 2).mem t)
    (x : Fin 3 → ℝ) (hx : ∀ a, (relativeBox a).mem (x a)) (w : Fin 2 → ℝ) :
    0≤∑ i : Fin 2, ∑ j : Fin 2,
      GramGraph.hessian (fun a b => formalHessianEntry Entry.exp (fun E => coefficient E.index) a b x entries)
        (formalDerivative Entry.exp (fun E => coefficient E.index) 0 x entries) v t i j*w j*w i :=
  LocalQuadratic2.nonnegative_of_certificate PSD0.matrix graph_hessian_symmetric PSD0.certificate _
    (graph_hessian_mem hv ht x hx) w
end ThomsonNine.ActualBoundary.C09
