def inverse : Bounds := ⟨6276464153802645426447750815926707045070942289008785359125660993978195186787551684699001866182362704191351402326361044701507607763891596196227368505299316373948241256990461415086345357655331564403921810014735923897211959845455211317,6441481199835347821315263137105669734990517270328954092048538636164530661047321935039162525496447343649059844666874403056277086067701837287687369386494956666654864237684161064359932607801024619623523502273406156446943171580844309615⟩
def pivotInterval : RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
def inverseInterval : RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
theorem positive : 0<(matrix 0 0).lo := by decide +kernel
theorem inverse_rule : InverseRule LocalShift.scale (matrix 0 0) inverse := by
  apply inverseRule_of_rat LocalShift.scale_pos (matrix 0 0) inverse pivotInterval inverseInterval <;> decide +kernel
theorem next_bounds : ∀ i j : Fin 1, Contains (PSD1.matrix i j) (reducedMatrix LocalShift.scale matrix inverse i j) := by
  unfold Contains
  decide +kernel
theorem certificate : PSDSound LocalShift.scale matrix :=
  step_psdSound LocalShift.scale_pos matrix PSD1.matrix inverse positive inverse_rule next_bounds PSD1.certificate
end ThomsonNine.ActualBoundary.C06.PSD0
