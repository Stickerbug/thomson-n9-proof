import LocalBoundary.C06.PSD2
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000000
noncomputable section
namespace ThomsonNine.ActualBoundary.C06.PSD1
open ThomsonNine.FixedInterval ThomsonNine.FixedInterval.Schur
open ThomsonNine.Interval (RatInterval)
def matrix : Fin 1 → Fin 1 → Bounds := ![![⟨5141005415111329622777268476662791493757584100046088714382550946388240273173125528588060198472629732389407939189687028272542291953840337024014458096603317919303141719938252000559449964233918542535834588958016779417806443523841977,12731477449866057649221835911324311900100558827367093355881998400502909417909864231115992765714013516094763144197815846193896695806803680116452722010004933429164848921953434784523449719430693161417912191863884491728849515830185729⟩]]
def inverse : Bounds := ⟨189319145119829783771464717073955045798979701311017547928736175215382603669636815002632714582758868861740688057809401842156530913392722392586483860401926085989515955580554304792543370784162029059210596970916452062365030768552117247654,468840670705427905791816749139037843593350931927616733383110387309873018916746842563951113134463510954768146843909889423982640121134487942467015720767277441594916642417483570871053754677298998897882709986514731506974223458709011062392⟩
def pivotInterval : RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
def inverseInterval : RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
theorem positive : 0<(matrix 0 0).lo := by decide +kernel
theorem inverse_rule : InverseRule LocalShift.scale (matrix 0 0) inverse := by
  apply inverseRule_of_rat LocalShift.scale_pos (matrix 0 0) inverse pivotInterval inverseInterval <;> decide +kernel
theorem next_bounds : ∀ i j : Fin 0, Contains (PSD2.matrix i j) (reducedMatrix LocalShift.scale matrix inverse i j) := by
  unfold Contains
  decide +kernel
theorem certificate : PSDSound LocalShift.scale matrix :=
  step_psdSound LocalShift.scale_pos matrix PSD2.matrix inverse positive inverse_rule next_bounds PSD2.certificate
end ThomsonNine.ActualBoundary.C06.PSD1
