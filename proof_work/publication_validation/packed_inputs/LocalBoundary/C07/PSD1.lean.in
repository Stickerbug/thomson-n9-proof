import LocalBoundary.C07.PSD2
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000000
noncomputable section
namespace ThomsonNine.ActualBoundary.C07.PSD1
open ThomsonNine.FixedInterval ThomsonNine.FixedInterval.Schur
open ThomsonNine.Interval (RatInterval)
def matrix : Fin 1 → Fin 1 → Bounds := ![![⟨1440266170417312572604469384227030334820632797331495086586637695578307955550582286690774955736281007426690369372378120866798711207072405433221222548608373809166814229784598971349304265252154537580367628589640243966357767428041359,13446964610160419729033428487970342614874000410787214848091581498173875833541819157642264566982733644196996738238259866283045785675981941049644777102890262231172033948123484258521024062276540519630575144013128508289123461403637790⟩]]
def inverse : Bounds := ⟨179245837019591741156152534405670794815652972741664447724176549771305596954206258159089492415632896582718456475777774996390715461052099752170758179510386395796527485425369323481182729808526006287509354992675672274125163063146093156983,1673518740096944843083046366284084666606887774091000367209185931881770271007420556660044322962761928935481338202194060127068381945042566070467324558797400586483967045141392964048579587286055509193250852997905441584697225870408621947890⟩
def pivotInterval : RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
def inverseInterval : RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
theorem positive : 0<(matrix 0 0).lo := by decide +kernel
theorem inverse_rule : InverseRule LocalShift.scale (matrix 0 0) inverse := by
  apply inverseRule_of_rat LocalShift.scale_pos (matrix 0 0) inverse pivotInterval inverseInterval <;> decide +kernel
theorem next_bounds : ∀ i j : Fin 0, Contains (PSD2.matrix i j) (reducedMatrix LocalShift.scale matrix inverse i j) := by
  unfold Contains
  decide +kernel
theorem certificate : PSDSound LocalShift.scale matrix :=
  step_psdSound LocalShift.scale_pos matrix PSD2.matrix inverse positive inverse_rule next_bounds PSD2.certificate
end ThomsonNine.ActualBoundary.C07.PSD1
