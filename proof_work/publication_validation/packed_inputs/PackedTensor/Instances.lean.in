import PackedTensor.MaskModel
import PackedTensor.Half

namespace ThomsonNine.PackedTensor
theorem planes11_correct : PlaneSpec planes11 := by
  intro a c p
  exact planes11_spec a c p.1 p.2.1 p.2.2
theorem planes3_correct : PlaneSpec planes3 := by
  intro a c p
  exact planes3_spec a c p.1 p.2.1 p.2.2
end ThomsonNine.PackedTensor
