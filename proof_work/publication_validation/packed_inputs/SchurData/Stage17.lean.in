def inverse : Bounds := ⟨(-), (-)⟩
def pivotInterval : RatInterval := ⟨(- : ℚ), (- : ℚ), by decide +kernel⟩
def inverseInterval : RatInterval := ⟨(- : ℚ), (- : ℚ), by decide +kernel⟩

theorem inverse_rule : InverseRule unitScale (A 0 0) inverse := by
  apply inverseRule_of_rat unitScale_pos (A 0 0) inverse pivotInterval inverseInterval <;> decide +kernel

theorem next_matrix_bounds : ∀ i j : Fin 15, Contains (Stage18.A i j) (reducedMatrix unitScale A inverse i j) := by
  unfold Contains
  decide +kernel
theorem next_rhs_bounds : ∀ i : Fin 15, Contains (Stage18.b i) (reducedRhs unitScale A b inverse i) := by
  unfold Contains
  decide +kernel
theorem output_bounds : ∀ i : Fin 16, Contains (solution i) (recover unitScale A b inverse Stage18.solution i) := by
  unfold Contains
  decide +kernel

theorem certificate : Sound unitScale A b solution :=
  step_sound unitScale_pos A b solution inverse Stage18.A Stage18.b Stage18.solution
    inverse_rule next_matrix_bounds next_rhs_bounds Stage18.certificate output_bounds
end ThomsonNine.ContactSchur.Stage17
