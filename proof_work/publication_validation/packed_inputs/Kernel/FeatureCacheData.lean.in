def Fields (n : Fin 7) (k : Fin 11) : Prop := ∀ i : Fin 11,
    (inputFeatureJet (canonicalInput n) k i 0).value.lo=(cachedValue n k i).lo ∧
    (inputFeatureJet (canonicalInput n) k i 0).value.hi=(cachedValue n k i).hi ∧
    ((inputFeatureJet (canonicalInput n) k i 0).gradient 0).lo=(cachedDerivative n k i).lo ∧
    ((inputFeatureJet (canonicalInput n) k i 0).gradient 0).hi=(cachedDerivative n k i).hi
theorem fields0_00 : Fields 0 0 := by unfold Fields; decide +kernel
