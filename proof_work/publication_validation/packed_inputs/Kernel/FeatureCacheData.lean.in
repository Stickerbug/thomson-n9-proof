import Kernel.BasisJet
import Algebra.JetHornerProjection
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000000
noncomputable section
namespace ThomsonNine.ActualKernel.FeatureCache
open ThomsonNine.ContactJet
open ThomsonNine.ActualHermite.CoefficientData
open ThomsonNine.ActualKernel.BasisJet
open ThomsonNine.ListPolynomial
def coordinateValue : Fin 7 → ℝ := ![1,ActualHermite.node 9,ActualHermite.node 7,ActualHermite.node 2,ActualHermite.node 4,ActualHermite.node 10,ActualHermite.node 3]
def coordinateInput : Fin 7 → FixedInterval.Bounds := ![FixedInterval.constant unitScale 1,inputNode 9,inputNode 7,inputNode 2,inputNode 4,inputNode 10,inputNode 3]
theorem coordinate_mem (n : Fin 7) : FixedInterval.Mem unitScale (coordinateInput n) (coordinateValue n) := by
  fin_cases n
  · simpa [coordinateValue,coordinateInput] using FixedInterval.mem_constant unitScale 1
  · simpa [coordinateValue,coordinateInput] using inputNode_mem 9
  · simpa [coordinateValue,coordinateInput] using inputNode_mem 7
  · simpa [coordinateValue,coordinateInput] using inputNode_mem 2
  · simpa [coordinateValue,coordinateInput] using inputNode_mem 4
  · simpa [coordinateValue,coordinateInput] using inputNode_mem 10
  · simpa [coordinateValue,coordinateInput] using inputNode_mem 3
def canonicalPoint (n : Fin 7) : Point := ![coordinateValue n,0,0]
def canonicalInput (n : Fin 7) : Fin 3 → FixedInterval.Bounds := ![coordinateInput n,FixedInterval.zero,FixedInterval.zero]
theorem canonical_mem (n : Fin 7) (j : Fin 3) :
    FixedInterval.Mem unitScale (canonicalInput n j) (canonicalPoint n j) := by
  fin_cases j
  · exact coordinate_mem n
  all_goals exact FixedInterval.mem_zero unitScale
