import F.CoefficientCache
import Matrices.Actual
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000000
noncomputable section
namespace ThomsonNine.ActualF.Constants
open ThomsonNine.CertificateMatrices ThomsonNine.ActualHermite.CoefficientData ThomsonNine.FixedInterval
open scoped BigOperators
def F111 (X : Fin 190 → ℝ) : ℝ := F X 1 1 1
def F111input : Bounds := ⟨, ⟩
def F111raw : Bounds := Schur.sumFin Cached.input
theorem F111input_fields : F111raw.lo=F111input.lo ∧ F111raw.hi=F111input.hi := by decide +kernel
theorem F111_mem (X : Fin 190 → ℝ) (hX : ∀ h, Mem unitScale (solutionInput h) (X h)) :
    Mem unitScale F111input (F111 X) := by
  have hh := Schur.sumFin_mem Cached.input (coefficient X) (fun j => Cached.input_mem X hX j)
  have he : F111 X=∑ j : Fin 756, coefficient X j := by simp [F111,F,QPolynomial.monomial]
  rw [← he] at hh
  change (F111input.lo : ℝ)≤(unitScale : ℝ)*F111 X ∧ (unitScale : ℝ)*F111 X≤F111input.hi
  rw [← F111input_fields.1,← F111input_fields.2]
  exact hh
def c (X : Fin 190 → ℝ) : ℝ := (1/12)*ActualContact.E+(1/8)*F111 X
def cInput : Bounds := add
  (mul unitScale (rational unitScale (1/12)) ActualContact.inputE)
  (mul unitScale (rational unitScale (1/8)) F111input)
theorem c_mem (X : Fin 190 → ℝ) (hX : ∀ h, Mem unitScale (solutionInput h) (X h)) :
    Mem unitScale cInput (c X) := by
  have h12 : Mem unitScale (rational unitScale (1/12)) (1/12 : ℝ) := by simpa using rational_mem unitScale (1/12)
  have h8 : Mem unitScale (rational unitScale (1/8)) (1/8 : ℝ) := by simpa using rational_mem unitScale (1/8)
  exact mem_add (mem_mul unitScale_pos h12 ActualContact.E_mem) (mem_mul unitScale_pos h8 (F111_mem X hX))
def cInterval : Interval.RatInterval := ⟨( : ℚ), ( : ℚ), by decide +kernel⟩
def F111Interval : Interval.RatInterval := ⟨( : ℚ), ( : ℚ), by decide +kernel⟩
def energyInterval : Interval.RatInterval := ⟨( : ℚ), ( : ℚ), by decide +kernel⟩
theorem c_bounds : (unitScale : ℚ)*cInterval.lo≤cInput.lo ∧ (cInput.hi : ℚ)≤(unitScale : ℚ)*cInterval.hi := by decide +kernel
theorem F111_bounds : (unitScale : ℚ)*F111Interval.lo≤F111input.lo ∧ (F111input.hi : ℚ)≤(unitScale : ℚ)*F111Interval.hi := by decide +kernel
theorem energy_bounds : (unitScale : ℚ)*energyInterval.lo≤ActualContact.inputE.lo ∧ (ActualContact.inputE.hi : ℚ)≤(unitScale : ℚ)*energyInterval.hi := by decide +kernel
theorem actual_c_mem : cInterval.mem (c ActualContact.SystemCertificate.X) :=
  mem_to_rat (c_mem _ actual_X_mem) unitScale_pos c_bounds.1 c_bounds.2
theorem actual_F111_mem : F111Interval.mem (F111 ActualContact.SystemCertificate.X) :=
  mem_to_rat (F111_mem _ actual_X_mem) unitScale_pos F111_bounds.1 F111_bounds.2
theorem actual_familyEnergy_mem : energyInterval.mem (familyEnergy RefinedRadius.radius) := by
  rw [← contact_energy_eq_family]
  exact mem_to_rat ActualContact.E_mem unitScale_pos energy_bounds.1 energy_bounds.2
end ThomsonNine.ActualF.Constants
