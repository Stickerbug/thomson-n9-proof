theorem width_positive : lo<hi := by decide +kernel
theorem compose_fields : ExactPolynomial.compose gList [lo,hi-lo]=localPoly := by decide +kernel
theorem bernstein_fields : PairBernstein75.combination bernsteinCoefficients=localPoly := by decide +kernel
theorem coefficient_lower : ∀ i, lower≤bernsteinCoefficients i := by decide +kernel
theorem value_lower (x : ℝ) (hx : (lo : ℝ)≤x ∧ x≤(hi : ℝ)) :
    (lower : ℝ)≤(RationalListPolynomial.realPolynomial gList).eval x :=
  leaf_lower gList localPoly lo hi lower bernsteinCoefficients width_positive compose_fields bernstein_fields coefficient_lower x hx
end Leaf06
end ThomsonNine.PairBounds
