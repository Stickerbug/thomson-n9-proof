theorem power_zero : powerCache 0=[1] := by decide +kernel
theorem power_step : ∀ n : Fin 75, powerCache ⟨n.val+1,by omega⟩=
    IntegerListPolynomial.mul [1,-1] (powerCache ⟨n.val,by omega⟩) := by decide +kernel
theorem basis_fields : ∀ i : Fin 76, basis i=IntegerListPolynomial.scale (Nat.choose 75 i.val)
    ((List.replicate i.val 0)++powerCache ⟨75-i.val,by omega⟩) := by decide +kernel
end ThomsonNine.PairBernstein75
