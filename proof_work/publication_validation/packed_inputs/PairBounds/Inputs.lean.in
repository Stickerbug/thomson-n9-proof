theorem p_as_list : PairAddition.P=realPolynomial pList := by
  ext n
  rw [PairAddition.P_coeff,RationalListPolynomial.coefficient]
  unfold pList
  by_cases hn : n<38 <;> simp only [List.getElem?_ofFn,hn,dite_true,dite_false,Option.getD_some,Option.getD_none,Rat.cast_zero]
theorem g_fields : ExactPolynomial.sub [1] (ExactPolynomial.mul [2,-2] (ExactPolynomial.pow pList 2))=gList := by decide +kernel
theorem gGap_fields : ExactPolynomial.sub [1] (ExactPolynomial.mul [2,-2] (ExactPolynomial.pow (ExactPolynomial.add pList [gap]) 2))=gGapList := by decide +kernel
theorem one_polynomial : realPolynomial [1]=(1 : ℝ[X]) := by simp [realPolynomial,ListPolynomial.polynomial]
theorem gap_polynomial : realPolynomial [gap]=C (gap : ℝ) := by simp [realPolynomial,ListPolynomial.polynomial]
theorem two_polynomial : realPolynomial [2,-2]=(C 2-C 2*X : ℝ[X]) := by
  simp [realPolynomial,ListPolynomial.polynomial]
  ring
theorem g_polynomial : realPolynomial gList=HermiteFactor.G PairAddition.P := by
  rw [← g_fields,ExactPolynomial.sub_sound,ExactPolynomial.mul_sound,ExactPolynomial.pow_sound,
    one_polynomial,two_polynomial,← p_as_list]
  rfl
theorem gGap_polynomial : realPolynomial gGapList=HermiteFactor.G (PairAddition.P+C (gap : ℝ)) := by
  rw [← gGap_fields,ExactPolynomial.sub_sound,ExactPolynomial.mul_sound,ExactPolynomial.pow_sound,
    ExactPolynomial.add_sound,one_polynomial,two_polynomial,← p_as_list,gap_polynomial]
  rfl
end ThomsonNine.PairBounds
