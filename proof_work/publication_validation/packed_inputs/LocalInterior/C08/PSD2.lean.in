import LocalInterior.C08.PSD3
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000000
noncomputable section
namespace ThomsonNine.ActualLocal.C08.PSD2
open ThomsonNine.FixedInterval ThomsonNine.FixedInterval.Schur
open ThomsonNine.Interval (RatInterval)
def matrix : Fin 1 → Fin 1 → Bounds := ![![⟨3276680004536930925384764795477837519852651264584570732566224045610765661804046077131230938839561461523516624117949367320180343993845740087457576263177708523714425888619733817152120564909209247091648404917399730514761759275857122,5079228529482790998258229830328218418071273413817649969294585549490957903633021038519413196781757969796551038772183539654470908129387005768650084006231570766017896007831488218223042232167852167881263319923424075849430778098943037⟩]]
def inverse : Bounds := ⟨474543016312453755320713905818899395697801883253570521701085279471342772774756103740811470996589679734412890685178355611110642162678551064638158338047036668091158883866683438515459653627108254414368281749009404698050090352724021972981,735595915250706426044800249558597014619226782868426441259922331566801547364750487367540822169336837288819744278404864044625823047190328519136203090601215615863463740925264649941499681933210085683457675287783880451450735369089336284369⟩
def pivotInterval : RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
def inverseInterval : RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
theorem positive : 0<(matrix 0 0).lo := by decide +kernel
theorem inverse_rule : InverseRule LocalShift.scale (matrix 0 0) inverse := by
  apply inverseRule_of_rat LocalShift.scale_pos (matrix 0 0) inverse pivotInterval inverseInterval <;> decide +kernel
theorem next_bounds : ∀ i j : Fin 0, Contains (PSD3.matrix i j) (reducedMatrix LocalShift.scale matrix inverse i j) := by
  unfold Contains
  decide +kernel
theorem certificate : PSDSound LocalShift.scale matrix :=
  step_psdSound LocalShift.scale_pos matrix PSD3.matrix inverse positive inverse_rule next_bounds PSD3.certificate
end ThomsonNine.ActualLocal.C08.PSD2
