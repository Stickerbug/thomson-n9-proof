import LocalInterior.C05.Certified
import LocalShift.BoundaryGeometry
import ThomsonNine.IntervalLocalOps
set_option maxRecDepth 100000
noncomputable section
namespace ThomsonNine.ActualLocal.C05
def sourceBox : Fin 3 → Interval.RatInterval := ![⟨(380539460067328772228646722827353796696101037566709227042220982849228701871417598205173310807276800286373933346717/39402006196394479212279040100143613805079739270465446667948293404245721771497210611414266254884915640806627990306816 : ℚ),(388419861306607668071102530847382519457116985420802316375810641530077846225717040327456164058253783414577794575781/39402006196394479212279040100143613805079739270465446667948293404245721771497210611414266254884915640806627990306816 : ℚ),by decide +kernel⟩,
⟨(13994574730764530882576365941344355923785336478168510939793755044020670239253215845048591290594918594451926448055203/39402006196394479212279040100143613805079739270465446667948293404245721771497210611414266254884915640806627990306816 : ℚ),(14002455132003809778418821749364384646546352426022604029127344702701519383607515287170874143845895577580095256541649/39402006196394479212279040100143613805079739270465446667948293404245721771497210611414266254884915640806627990306816 : ℚ),by decide +kernel⟩,
⟨(13994574730764530882576365941344355923785336478168510939793755044020670239253215845048591290594918594451926448055203/39402006196394479212279040100143613805079739270465446667948293404245721771497210611414266254884915640806627990306816 : ℚ),(14002455132003809778418821749364384646546352426022604029127344702701519383607515287170874143845895577580095256541649/39402006196394479212279040100143613805079739270465446667948293404245721771497210611414266254884915640806627990306816 : ℚ),by decide +kernel⟩]
theorem relative_bounds : ∀ a, (relativeBox a).lo≤((sourceBox a).sub (LocalShift.centerInterval localId a)).lo ∧
    ((sourceBox a).sub (LocalShift.centerInterval localId a)).hi≤(relativeBox a).hi := by decide +kernel
theorem actual_residual_nonnegative_on_source (p : Fin 3 → ℝ) (hp : ∀ a, (sourceBox a).mem (p a)) :
    0≤ActualR.residual p := by
  have hx (a : Fin 3) : (relativeBox a).mem (p a-LocalShift.center localId a) :=
    Interval.RatInterval.mem_subset (Interval.RatInterval.mem_sub (hp a) (LocalShift.center_interval_mem localId a))
      (relative_bounds a).1 (relative_bounds a).2
  have h := actual_residual_nonnegative (fun a => p a-LocalShift.center localId a) hx
  have he : (fun a => LocalShift.center localId a+(p a-LocalShift.center localId a))=p := by
    funext a
    ring
  rw [he] at h
  exact h
end ThomsonNine.ActualLocal.C05
