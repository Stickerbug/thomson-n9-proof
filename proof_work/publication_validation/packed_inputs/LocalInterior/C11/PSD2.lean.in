import LocalInterior.C11.PSD3
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000000
noncomputable section
namespace ThomsonNine.ActualLocal.C11.PSD2
open ThomsonNine.FixedInterval ThomsonNine.FixedInterval.Schur
open ThomsonNine.Interval (RatInterval)
def matrix : Fin 1 → Fin 1 → Bounds := ![![⟨35090610454660086371826687866186259935903714871728287913926369826103539760431029075285358452590965422187783433346347673820130330282848547790303647399962387719583208706271021095664447698522363220332369310979022965407706447654730604,52485511952610708115272918823657910068303401436218771931075253833815565237808473677836512135408206968583414633748323326725832303510188128107298932485481433726598881979016879252785263828340158016100853289225006607064181802397161974⟩]]
def inverse : Bounds := ⟨45923386040271634084041136567865721326160393643147442715697143421287428014096178771539756968323043903385699035510116315321154311038177109176758261612859545701327836182700923895035474182863343160837629467754629354966749598073744484825,68688244396185459833308539153065152032388644072797816185119900757366739858842217817391340295272710672925491983249739639701305630006911836045609082597433967645937881891121791533142485960498040573597884507030996133477693239298863896929⟩
def pivotInterval : RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
def inverseInterval : RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
theorem positive : 0<(matrix 0 0).lo := by decide +kernel
theorem inverse_rule : InverseRule LocalShift.scale (matrix 0 0) inverse := by
  apply inverseRule_of_rat LocalShift.scale_pos (matrix 0 0) inverse pivotInterval inverseInterval <;> decide +kernel
theorem next_bounds : ∀ i j : Fin 0, Contains (PSD3.matrix i j) (reducedMatrix LocalShift.scale matrix inverse i j) := by
  unfold Contains
  decide +kernel
theorem certificate : PSDSound LocalShift.scale matrix :=
  step_psdSound LocalShift.scale_pos matrix PSD3.matrix inverse positive inverse_rule next_bounds PSD3.certificate
end ThomsonNine.ActualLocal.C11.PSD2
