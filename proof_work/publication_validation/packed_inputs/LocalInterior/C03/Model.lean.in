    exact power_mem LocalShift.scale_pos hd n
def hessianComputed (i j : Fin 3) : Bounds :=
  FixedSparseHessian.hessianInput LocalShift.scale Entry.exp (fun E => input E.index) powers i j entries
theorem hessianComputed_mem (i j : Fin 3) (x : Fin 3 → ℝ)
    (hx : ∀ a, (relativeBox a).mem (x a)) :
    Mem LocalShift.scale (hessianComputed i j)
      (Interval.SparsePolynomial.formalHessianEntry Entry.exp (fun E => coefficient E.index) i j x entries) := by
  apply FixedSparseHessian.hessianInput_mem LocalShift.scale_pos Entry.exp (fun E => input E.index)
    (fun E => coefficient E.index) powers x i j entries
  · intro E hE
    exact LocalShift.Stage03_2.output_mem E.index
  · intro a n
    exact powers_mem a (hx a) n
