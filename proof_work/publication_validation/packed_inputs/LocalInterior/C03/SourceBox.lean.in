import LocalInterior.C03.Certified
import LocalShift.BoundaryGeometry
import ThomsonNine.IntervalLocalOps
set_option maxRecDepth 100000
noncomputable section
namespace ThomsonNine.ActualLocal.C03
def sourceBox : Fin 3 → Interval.RatInterval := ![⟨(4761369898693499579372537507403866859453699159862789695768681599257472382783189976396208122195885012836488760376917/19701003098197239606139520050071806902539869635232723333974146702122860885748605305707133127442457820403313995153408 : ℚ),(2400385952444947029292408273752005236629389449566627571218314946330859052277343593503811194225384964238655669614425/9850501549098619803069760025035903451269934817616361666987073351061430442874302652853566563721228910201656997576704 : ℚ),by decide +kernel⟩,
⟨(13959112925187775851285314805254226671360764712825092037792601579956849089658868355498318450965522170375200482863927/39402006196394479212279040100143613805079739270465446667948293404245721771497210611414266254884915640806627990306816 : ℚ),(14037916937580564809709872885454513898970924191366022931128498166765340533201862776721146983475292001656821221732925/39402006196394479212279040100143613805079739270465446667948293404245721771497210611414266254884915640806627990306816 : ℚ),by decide +kernel⟩,
⟨(13959112925187775851285314805254226671360764712825092037792601579956849089658868355498318450965522170375200482863927/39402006196394479212279040100143613805079739270465446667948293404245721771497210611414266254884915640806627990306816 : ℚ),(14037916937580564809709872885454513898970924191366022931128498166765340533201862776721146983475292001656821221732925/39402006196394479212279040100143613805079739270465446667948293404245721771497210611414266254884915640806627990306816 : ℚ),by decide +kernel⟩]
theorem relative_bounds : ∀ a, (relativeBox a).lo≤((sourceBox a).sub (LocalShift.centerInterval localId a)).lo ∧
    ((sourceBox a).sub (LocalShift.centerInterval localId a)).hi≤(relativeBox a).hi := by decide +kernel
theorem actual_residual_nonnegative_on_source (p : Fin 3 → ℝ) (hp : ∀ a, (sourceBox a).mem (p a)) :
    0≤ActualR.residual p := by
  have hx (a : Fin 3) : (relativeBox a).mem (p a-LocalShift.center localId a) :=
    Interval.RatInterval.mem_subset (Interval.RatInterval.mem_sub (hp a) (LocalShift.center_interval_mem localId a))
      (relative_bounds a).1 (relative_bounds a).2
  have h := actual_residual_nonnegative (fun a => p a-LocalShift.center localId a) hx
  have he : (fun a => LocalShift.center localId a+(p a-LocalShift.center localId a))=p := by
    funext a
    ring
  rw [he] at h
  exact h
end ThomsonNine.ActualLocal.C03
