import LocalInterior.C10.PSD3
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000000
noncomputable section
namespace ThomsonNine.ActualLocal.C10.PSD2
open ThomsonNine.FixedInterval ThomsonNine.FixedInterval.Schur
open ThomsonNine.Interval (RatInterval)
def matrix : Fin 1 → Fin 1 → Bounds := ![![⟨4035935108134127451366849993258217350477732253346116579518018926208011955662779966076370726527441814574348493172790053477485663332475361146664506405665334899690005126975109765245096793177741178161478307205181952381662000113212082,35524898226383606719872456097738039298394586377070921540658678458617284558152976937528914212031540630472765013191189707646825547837570786057389837533595539976333031118006189413121557334394835220606517338669746891447239128755229187⟩]]
def inverse : Bounds := ⟨67848538553474121732096936900473496774649431808507913592222133900475669987466967818314524433616614127634422187128634813292596568879175305042283666120231909729396276880027318684681064027827977935480254240764455094132057659319454352489,597212879380351510633201205981501354651009261562561492715246240089483026400508254177505048361401661829417121879532380777356581732390250643752798095041948875599713099020517853898100861098500470306811764891106844819903279847242501572069⟩
def pivotInterval : RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
def inverseInterval : RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
theorem positive : 0<(matrix 0 0).lo := by decide +kernel
theorem inverse_rule : InverseRule LocalShift.scale (matrix 0 0) inverse := by
  apply inverseRule_of_rat LocalShift.scale_pos (matrix 0 0) inverse pivotInterval inverseInterval <;> decide +kernel
theorem next_bounds : ∀ i j : Fin 0, Contains (PSD3.matrix i j) (reducedMatrix LocalShift.scale matrix inverse i j) := by
  unfold Contains
  decide +kernel
theorem certificate : PSDSound LocalShift.scale matrix :=
  step_psdSound LocalShift.scale_pos matrix PSD3.matrix inverse positive inverse_rule next_bounds PSD3.certificate
end ThomsonNine.ActualLocal.C10.PSD2
