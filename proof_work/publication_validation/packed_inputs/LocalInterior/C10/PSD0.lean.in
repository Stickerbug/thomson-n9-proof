def pivotInterval : RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
def inverseInterval : RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
theorem positive : 0<(matrix 0 0).lo := by decide +kernel
theorem inverse_rule : InverseRule LocalShift.scale (matrix 0 0) inverse := by
  apply inverseRule_of_rat LocalShift.scale_pos (matrix 0 0) inverse pivotInterval inverseInterval <;> decide +kernel
theorem next_bounds : ∀ i j : Fin 2, Contains (PSD1.matrix i j) (reducedMatrix LocalShift.scale matrix inverse i j) := by
  unfold Contains
  decide +kernel
theorem certificate : PSDSound LocalShift.scale matrix :=
  step_psdSound LocalShift.scale_pos matrix PSD1.matrix inverse positive inverse_rule next_bounds PSD1.certificate
