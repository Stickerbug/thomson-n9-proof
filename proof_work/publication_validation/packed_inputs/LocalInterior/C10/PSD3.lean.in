import Algebra.IntervalPSD
import LocalShift.Inputs
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000000
noncomputable section
namespace ThomsonNine.ActualLocal.C10.PSD3
open ThomsonNine.FixedInterval ThomsonNine.FixedInterval.Schur
def matrix : Fin 0 → Fin 0 → Bounds := Fin.elim0
theorem certificate : PSDSound LocalShift.scale matrix := empty_psdSound LocalShift.scale matrix
end ThomsonNine.ActualLocal.C10.PSD3
