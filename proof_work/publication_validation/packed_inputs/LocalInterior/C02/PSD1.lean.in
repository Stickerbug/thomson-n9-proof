def inverse : Bounds := ⟨22411875497518536532094532691497426192061764761552677167521392274326308297110771002679049975773269532455832841319938482736019994974881433319487613385563119418122816035947325492800205254746138555159686555811775958416047356871336277846,32033349683696670688279381153500481865300853900918100602485702311529633256594795174757667123790408911219003006614893509774457220152922206280829822830036533775756620799084534077095987943829192230058536178677335265487205346031258264507⟩
def pivotInterval : RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
def inverseInterval : RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
theorem positive : 0<(matrix 0 0).lo := by decide +kernel
theorem inverse_rule : InverseRule LocalShift.scale (matrix 0 0) inverse := by
  apply inverseRule_of_rat LocalShift.scale_pos (matrix 0 0) inverse pivotInterval inverseInterval <;> decide +kernel
theorem next_bounds : ∀ i j : Fin 1, Contains (PSD2.matrix i j) (reducedMatrix LocalShift.scale matrix inverse i j) := by
  unfold Contains
  decide +kernel
theorem certificate : PSDSound LocalShift.scale matrix :=
  step_psdSound LocalShift.scale_pos matrix PSD2.matrix inverse positive inverse_rule next_bounds PSD2.certificate
end ThomsonNine.ActualLocal.C02.PSD1
