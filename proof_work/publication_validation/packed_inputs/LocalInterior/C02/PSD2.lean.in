import LocalInterior.C02.PSD3
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000000
noncomputable section
namespace ThomsonNine.ActualLocal.C02.PSD2
open ThomsonNine.FixedInterval ThomsonNine.FixedInterval.Schur
open ThomsonNine.Interval (RatInterval)
def matrix : Fin 1 → Fin 1 → Bounds := ![![⟨2174506526201152471155842739611378095744313882418741996332748163203571212640757100719017353766340398375249150580915391414387692669191332467355614366657618572118154888155981383258962936416715018046212243841783231584232880317987053,6225525963943421295463704944456607029751332492319342764534259345030492489176125276837109482193802055076011132858248812451458159435771197647606168194275435622359788040748364326766124305136656569199294908390136974626603087041731425⟩]]
def inverse : Bounds := ⟨387166070928129847458080173136376723058681718014404622717489281284724853148819191431266352019407466504955514419019208281440726053432485133893698419088251860135075437442290311933248801294431144237088784284379349169896338700758501828744,1108441109685622033509652112023378405222141030434670953790026672061661767639804861493626605163492415100026477200218121409748050957204020017692444449124519745235532386699020966458540823908905341071659926098168024444919986111790694646553⟩
def pivotInterval : RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
def inverseInterval : RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
theorem positive : 0<(matrix 0 0).lo := by decide +kernel
theorem inverse_rule : InverseRule LocalShift.scale (matrix 0 0) inverse := by
  apply inverseRule_of_rat LocalShift.scale_pos (matrix 0 0) inverse pivotInterval inverseInterval <;> decide +kernel
theorem next_bounds : ∀ i j : Fin 0, Contains (PSD3.matrix i j) (reducedMatrix LocalShift.scale matrix inverse i j) := by
  unfold Contains
  decide +kernel
theorem certificate : PSDSound LocalShift.scale matrix :=
  step_psdSound LocalShift.scale_pos matrix PSD3.matrix inverse positive inverse_rule next_bounds PSD3.certificate
end ThomsonNine.ActualLocal.C02.PSD2
