import LocalInterior.C01.Certified
import LocalShift.BoundaryGeometry
import ThomsonNine.IntervalLocalOps
set_option maxRecDepth 100000
noncomputable section
namespace ThomsonNine.ActualLocal.C01
def sourceBox : Fin 3 → Interval.RatInterval := ![⟨(-14729662466371878401046519661204191337835580086951346301350380464738651291143957924902631216715491949603219003246353/19701003098197239606139520050071806902539869635232723333974146702122860885748605305707133127442457820403313995153408 : ℚ),(-29451444531504477906250583514388353952910144226048599513367171270796453437933616407682979580180006916078266046986893/39402006196394479212279040100143613805079739270465446667948293404245721771497210611414266254884915640806627990306816 : ℚ),by decide +kernel⟩,
⟨(380539460067328772228646722827353796696101037566709227042220982849228701871417598205173310807276800286373933346717/39402006196394479212279040100143613805079739270465446667948293404245721771497210611414266254884915640806627990306816 : ℚ),(388419861306607668071102530847382519457116985420802316375810641530077846225717040327456164058253783414577794575781/39402006196394479212279040100143613805079739270465446667948293404245721771497210611414266254884915640806627990306816 : ℚ),by decide +kernel⟩,
⟨(4779100801481877095018063075448931485665985042534499146769258331289382957580363721171344542010583224874851742972555/19701003098197239606139520050071806902539869635232723333974146702122860885748605305707133127442457820403313995153408 : ℚ),(1195760250525379135734822744864736461761623254115386422859013290157451882439378360558121492159017929109737089158303/4925250774549309901534880012517951725634967408808180833493536675530715221437151326426783281860614455100828498788352 : ℚ),by decide +kernel⟩]
theorem relative_bounds : ∀ a, (relativeBox a).lo≤((sourceBox a).sub (LocalShift.centerInterval localId a)).lo ∧
    ((sourceBox a).sub (LocalShift.centerInterval localId a)).hi≤(relativeBox a).hi := by decide +kernel
theorem actual_residual_nonnegative_on_source (p : Fin 3 → ℝ) (hp : ∀ a, (sourceBox a).mem (p a)) :
    0≤ActualR.residual p := by
  have hx (a : Fin 3) : (relativeBox a).mem (p a-LocalShift.center localId a) :=
    Interval.RatInterval.mem_subset (Interval.RatInterval.mem_sub (hp a) (LocalShift.center_interval_mem localId a))
      (relative_bounds a).1 (relative_bounds a).2
  have h := actual_residual_nonnegative (fun a => p a-LocalShift.center localId a) hx
  have he : (fun a => LocalShift.center localId a+(p a-LocalShift.center localId a))=p := by
    funext a
    ring
  rw [he] at h
  exact h
end ThomsonNine.ActualLocal.C01
