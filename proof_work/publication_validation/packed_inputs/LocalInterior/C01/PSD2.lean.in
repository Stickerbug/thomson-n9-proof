import LocalInterior.C01.PSD3
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000000
noncomputable section
namespace ThomsonNine.ActualLocal.C01.PSD2
open ThomsonNine.FixedInterval ThomsonNine.FixedInterval.Schur
open ThomsonNine.Interval (RatInterval)
def matrix : Fin 1 → Fin 1 → Bounds := ![![⟨3798253889850627107617067438132754355182997178888135734480736923071229781893242579731530132855667960886192581033220805431628023146524592412256628488633776184500354797605975323377848244170076211807335029252800926395440383039553272,5657212923083158565831653800076419085507329122823919952804835296251678562093557462546571320882989254803090552374555899525783741370965199506526146163874436151284319361873232091871710931861858149723335332992778094596380128095760040⟩]]
def inverse : Bounds := ⟨426060051069709763118809584644651826281629768049074441059061569477367238118612709398609195219071617368338646665845743355556569983014003787181156331489308410312006328961806069882779030957049003281299117365353834283174327803175619989813,634584337124399624185547572122014393482413214773272608144536778119296749962554585195267653436009718402735834185012377492735750092501443176295724977258612139958858765298541598531640381288214830955462787474830036775977709716102535096508⟩
def pivotInterval : RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
def inverseInterval : RatInterval := ⟨( : ℚ),( : ℚ),by decide +kernel⟩
theorem positive : 0<(matrix 0 0).lo := by decide +kernel
theorem inverse_rule : InverseRule LocalShift.scale (matrix 0 0) inverse := by
  apply inverseRule_of_rat LocalShift.scale_pos (matrix 0 0) inverse pivotInterval inverseInterval <;> decide +kernel
theorem next_bounds : ∀ i j : Fin 0, Contains (PSD3.matrix i j) (reducedMatrix LocalShift.scale matrix inverse i j) := by
  unfold Contains
  decide +kernel
theorem certificate : PSDSound LocalShift.scale matrix :=
  step_psdSound LocalShift.scale_pos matrix PSD3.matrix inverse positive inverse_rule next_bounds PSD3.certificate
end ThomsonNine.ActualLocal.C01.PSD2
