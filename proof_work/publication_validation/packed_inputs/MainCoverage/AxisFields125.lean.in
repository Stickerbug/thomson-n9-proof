def axisDiagIds125 : Fin 32 → ℕ := ![4006,4007,4008,4009,4010,4011,4012,4013,4014,4015,4016,4017,4018,4019,4020,4021,4022,4023,4024,4025,4026,4027,4028,4029,4030,4031,4032,4033,4034,4035,4036,4037]
theorem axis_fields_125 : ∀ i : Fin 32, axisCertificateOK (axisLookup (4000+i.val)) (diagonalLookup (axisDiagIds125 i)).word (axisWitnesses125 i)=true := by decide +kernel
theorem axis_diag_fields_125 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds125 i)).level=(axisLookup (4000+i.val)).level ∧ (diagonalLookup (axisDiagIds125 i)).index=(axisLookup (4000+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
