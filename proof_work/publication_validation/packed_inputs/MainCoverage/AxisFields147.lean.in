def axisDiagIds147 : Fin 32 → ℕ := ![4710,4711,4712,4713,4714,4715,4716,4717,4718,4719,4720,4721,4722,4723,4724,4725,4726,4727,4728,4729,4730,4731,4732,4733,4734,4735,4736,4737,4738,4739,4740,4741]
theorem axis_fields_147 : ∀ i : Fin 32, axisCertificateOK (axisLookup (4704+i.val)) (diagonalLookup (axisDiagIds147 i)).word (axisWitnesses147 i)=true := by decide +kernel
theorem axis_diag_fields_147 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds147 i)).level=(axisLookup (4704+i.val)).level ∧ (diagonalLookup (axisDiagIds147 i)).index=(axisLookup (4704+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
