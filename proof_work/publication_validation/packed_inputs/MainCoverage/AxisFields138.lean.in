theorem axis_diag_fields_138 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds138 i)).level=(axisLookup (4416+i.val)).level ∧ (diagonalLookup (axisDiagIds138 i)).index=(axisLookup (4416+i.val)).index := by decide +kernel
