def axisDiagIds014 : Fin 32 → ℕ := ![453,454,455,456,457,458,459,460,461,462,463,464,465,466,467,468,469,470,471,472,473,474,475,476,477,478,479,480,481,482,483,484]
theorem axis_fields_14 : ∀ i : Fin 32, axisCertificateOK (axisLookup (448+i.val)) (diagonalLookup (axisDiagIds014 i)).word (axisWitnesses014 i)=true := by decide +kernel
theorem axis_diag_fields_14 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds014 i)).level=(axisLookup (448+i.val)).level ∧ (diagonalLookup (axisDiagIds014 i)).index=(axisLookup (448+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
