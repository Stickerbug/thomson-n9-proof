def axisDiagIds032 : Fin 32 → ℕ := ![1029,1030,1031,1032,1033,1034,1035,1036,1037,1038,1039,1040,1041,1042,1043,1044,1045,1046,1047,1048,1049,1050,1051,1052,1053,1054,1055,1056,1057,1058,1059,1060]
theorem axis_fields_32 : ∀ i : Fin 32, axisCertificateOK (axisLookup (1024+i.val)) (diagonalLookup (axisDiagIds032 i)).word (axisWitnesses032 i)=true := by decide +kernel
theorem axis_diag_fields_32 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds032 i)).level=(axisLookup (1024+i.val)).level ∧ (diagonalLookup (axisDiagIds032 i)).index=(axisLookup (1024+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
