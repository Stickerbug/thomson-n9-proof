def axisDiagIds114 : Fin 32 → ℕ := ![3654,3655,3656,3657,3658,3659,3660,3661,3662,3663,3664,3665,3666,3667,3668,3669,3670,3671,3672,3673,3674,3675,3676,3677,3678,3679,3680,3681,3682,3683,3684,3685]
theorem axis_fields_114 : ∀ i : Fin 32, axisCertificateOK (axisLookup (3648+i.val)) (diagonalLookup (axisDiagIds114 i)).word (axisWitnesses114 i)=true := by decide +kernel
theorem axis_diag_fields_114 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds114 i)).level=(axisLookup (3648+i.val)).level ∧ (diagonalLookup (axisDiagIds114 i)).index=(axisLookup (3648+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
