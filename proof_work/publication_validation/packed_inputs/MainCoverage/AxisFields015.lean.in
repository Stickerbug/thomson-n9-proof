def axisDiagIds015 : Fin 32 → ℕ := ![485,486,487,488,489,490,491,492,493,494,495,496,497,498,499,500,501,502,503,504,505,506,507,508,509,510,511,512,513,514,515,516]
theorem axis_fields_15 : ∀ i : Fin 32, axisCertificateOK (axisLookup (480+i.val)) (diagonalLookup (axisDiagIds015 i)).word (axisWitnesses015 i)=true := by decide +kernel
theorem axis_diag_fields_15 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds015 i)).level=(axisLookup (480+i.val)).level ∧ (diagonalLookup (axisDiagIds015 i)).index=(axisLookup (480+i.val)).index := by decide +kernel
