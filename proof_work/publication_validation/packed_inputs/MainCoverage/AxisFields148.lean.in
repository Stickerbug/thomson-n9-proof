def axisDiagIds148 : Fin 32 → ℕ := ![4742,4743,4744,4745,4746,4747,4748,4749,4750,4751,4752,4753,4754,4755,4756,4757,4758,4759,4760,4761,4762,4763,4764,4765,4766,4767,4768,4769,4770,4771,4772,4773]
theorem axis_fields_148 : ∀ i : Fin 32, axisCertificateOK (axisLookup (4736+i.val)) (diagonalLookup (axisDiagIds148 i)).word (axisWitnesses148 i)=true := by decide +kernel
theorem axis_diag_fields_148 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds148 i)).level=(axisLookup (4736+i.val)).level ∧ (diagonalLookup (axisDiagIds148 i)).index=(axisLookup (4736+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
