def axisDiagIds130 : Fin 32 → ℕ := ![4166,4167,4168,4169,4170,4171,4172,4173,4174,4175,4176,4177,4178,4179,4180,4181,4182,4183,4184,4185,4186,4187,4188,4189,4190,4191,4192,4193,4194,4195,4196,4197]
theorem axis_fields_130 : ∀ i : Fin 32, axisCertificateOK (axisLookup (4160+i.val)) (diagonalLookup (axisDiagIds130 i)).word (axisWitnesses130 i)=true := by decide +kernel
theorem axis_diag_fields_130 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds130 i)).level=(axisLookup (4160+i.val)).level ∧ (diagonalLookup (axisDiagIds130 i)).index=(axisLookup (4160+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
