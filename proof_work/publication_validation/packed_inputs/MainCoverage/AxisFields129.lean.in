theorem axis_diag_fields_129 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds129 i)).level=(axisLookup (4128+i.val)).level ∧ (diagonalLookup (axisDiagIds129 i)).index=(axisLookup (4128+i.val)).index := by decide +kernel
