theorem axis_diag_fields_75 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds075 i)).level=(axisLookup (2400+i.val)).level ∧ (diagonalLookup (axisDiagIds075 i)).index=(axisLookup (2400+i.val)).index := by decide +kernel
