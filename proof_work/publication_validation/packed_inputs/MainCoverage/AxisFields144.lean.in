def axisDiagIds144 : Fin 32 → ℕ := ![4614,4615,4616,4617,4618,4619,4620,4621,4622,4623,4624,4625,4626,4627,4628,4629,4630,4631,4632,4633,4634,4635,4636,4637,4638,4639,4640,4641,4642,4643,4644,4645]
theorem axis_fields_144 : ∀ i : Fin 32, axisCertificateOK (axisLookup (4608+i.val)) (diagonalLookup (axisDiagIds144 i)).word (axisWitnesses144 i)=true := by decide +kernel
theorem axis_diag_fields_144 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds144 i)).level=(axisLookup (4608+i.val)).level ∧ (diagonalLookup (axisDiagIds144 i)).index=(axisLookup (4608+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
