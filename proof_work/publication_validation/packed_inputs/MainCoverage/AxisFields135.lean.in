def axisDiagIds135 : Fin 32 → ℕ := ![4326,4327,4328,4329,4330,4331,4332,4333,4334,4335,4336,4337,4338,4339,4340,4341,4342,4343,4344,4345,4346,4347,4348,4349,4350,4351,4352,4353,4354,4355,4356,4357]
theorem axis_fields_135 : ∀ i : Fin 32, axisCertificateOK (axisLookup (4320+i.val)) (diagonalLookup (axisDiagIds135 i)).word (axisWitnesses135 i)=true := by decide +kernel
theorem axis_diag_fields_135 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds135 i)).level=(axisLookup (4320+i.val)).level ∧ (diagonalLookup (axisDiagIds135 i)).index=(axisLookup (4320+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
