def axisDiagIds050 : Fin 32 → ℕ := ![1606,1607,1608,1609,1610,1611,1612,1613,1614,1615,1616,1617,1618,1619,1620,1621,1622,1623,1624,1625,1626,1627,1628,1629,1630,1631,1632,1633,1634,1635,1636,1637]
theorem axis_fields_50 : ∀ i : Fin 32, axisCertificateOK (axisLookup (1600+i.val)) (diagonalLookup (axisDiagIds050 i)).word (axisWitnesses050 i)=true := by decide +kernel
theorem axis_diag_fields_50 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds050 i)).level=(axisLookup (1600+i.val)).level ∧ (diagonalLookup (axisDiagIds050 i)).index=(axisLookup (1600+i.val)).index := by decide +kernel
