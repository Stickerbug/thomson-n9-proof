def axisDiagIds133 : Fin 32 → ℕ := ![4262,4263,4264,4265,4266,4267,4268,4269,4270,4271,4272,4273,4274,4275,4276,4277,4278,4279,4280,4281,4282,4283,4284,4285,4286,4287,4288,4289,4290,4291,4292,4293]
theorem axis_fields_133 : ∀ i : Fin 32, axisCertificateOK (axisLookup (4256+i.val)) (diagonalLookup (axisDiagIds133 i)).word (axisWitnesses133 i)=true := by decide +kernel
theorem axis_diag_fields_133 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds133 i)).level=(axisLookup (4256+i.val)).level ∧ (diagonalLookup (axisDiagIds133 i)).index=(axisLookup (4256+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
