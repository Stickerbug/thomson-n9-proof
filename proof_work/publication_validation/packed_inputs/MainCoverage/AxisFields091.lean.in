theorem axis_diag_fields_91 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds091 i)).level=(axisLookup (2912+i.val)).level ∧ (diagonalLookup (axisDiagIds091 i)).index=(axisLookup (2912+i.val)).index := by decide +kernel
