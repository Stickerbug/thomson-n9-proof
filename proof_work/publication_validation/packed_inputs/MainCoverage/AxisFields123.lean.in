def axisDiagIds123 : Fin 32 → ℕ := ![3942,3943,3944,3945,3946,3947,3948,3949,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967,3968,3969,3970,3971,3972,3973]
theorem axis_fields_123 : ∀ i : Fin 32, axisCertificateOK (axisLookup (3936+i.val)) (diagonalLookup (axisDiagIds123 i)).word (axisWitnesses123 i)=true := by decide +kernel
theorem axis_diag_fields_123 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds123 i)).level=(axisLookup (3936+i.val)).level ∧ (diagonalLookup (axisDiagIds123 i)).index=(axisLookup (3936+i.val)).index := by decide +kernel
