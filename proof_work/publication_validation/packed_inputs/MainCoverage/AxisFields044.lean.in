theorem axis_diag_fields_44 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds044 i)).level=(axisLookup (1408+i.val)).level ∧ (diagonalLookup (axisDiagIds044 i)).index=(axisLookup (1408+i.val)).index := by decide +kernel
