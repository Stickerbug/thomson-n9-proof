def axisDiagIds102 : Fin 32 → ℕ := ![3270,3271,3272,3273,3274,3275,3276,3277,3278,3279,3280,3281,3282,3283,3284,3285,3286,3287,3288,3289,3290,3291,3292,3293,3294,3295,3296,3297,3298,3299,3300,3301]
theorem axis_fields_102 : ∀ i : Fin 32, axisCertificateOK (axisLookup (3264+i.val)) (diagonalLookup (axisDiagIds102 i)).word (axisWitnesses102 i)=true := by decide +kernel
theorem axis_diag_fields_102 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds102 i)).level=(axisLookup (3264+i.val)).level ∧ (diagonalLookup (axisDiagIds102 i)).index=(axisLookup (3264+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
