def axisDiagIds137 : Fin 32 → ℕ := ![4390,4391,4392,4393,4394,4395,4396,4397,4398,4399,4400,4401,4402,4403,4404,4405,4406,4407,4408,4409,4410,4411,4412,4413,4414,4415,4416,4417,4418,4419,4420,4421]
theorem axis_fields_137 : ∀ i : Fin 32, axisCertificateOK (axisLookup (4384+i.val)) (diagonalLookup (axisDiagIds137 i)).word (axisWitnesses137 i)=true := by decide +kernel
theorem axis_diag_fields_137 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds137 i)).level=(axisLookup (4384+i.val)).level ∧ (diagonalLookup (axisDiagIds137 i)).index=(axisLookup (4384+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
