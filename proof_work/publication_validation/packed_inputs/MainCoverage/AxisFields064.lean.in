def axisDiagIds064 : Fin 32 → ℕ := ![2054,2055,2056,2057,2058,2059,2060,2061,2062,2063,2064,2065,2066,2067,2068,2069,2070,2071,2072,2073,2074,2075,2076,2077,2078,2079,2080,2081,2082,2083,2084,2085]
theorem axis_fields_64 : ∀ i : Fin 32, axisCertificateOK (axisLookup (2048+i.val)) (diagonalLookup (axisDiagIds064 i)).word (axisWitnesses064 i)=true := by decide +kernel
theorem axis_diag_fields_64 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds064 i)).level=(axisLookup (2048+i.val)).level ∧ (diagonalLookup (axisDiagIds064 i)).index=(axisLookup (2048+i.val)).index := by decide +kernel
