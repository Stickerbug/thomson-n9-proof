def axisDiagIds143 : Fin 32 → ℕ := ![4582,4583,4584,4585,4586,4587,4588,4589,4590,4591,4592,4593,4594,4595,4596,4597,4598,4599,4600,4601,4602,4603,4604,4605,4606,4607,4608,4609,4610,4611,4612,4613]
theorem axis_fields_143 : ∀ i : Fin 32, axisCertificateOK (axisLookup (4576+i.val)) (diagonalLookup (axisDiagIds143 i)).word (axisWitnesses143 i)=true := by decide +kernel
theorem axis_diag_fields_143 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds143 i)).level=(axisLookup (4576+i.val)).level ∧ (diagonalLookup (axisDiagIds143 i)).index=(axisLookup (4576+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
