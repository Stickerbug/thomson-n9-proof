def axisDiagIds037 : Fin 32 → ℕ := ![1189,1190,1191,1192,1193,1194,1195,1196,1197,1198,1199,1200,1201,1202,1203,1204,1205,1206,1207,1208,1209,1210,1211,1212,1213,1214,1215,1216,1217,1218,1219,1220]
theorem axis_fields_37 : ∀ i : Fin 32, axisCertificateOK (axisLookup (1184+i.val)) (diagonalLookup (axisDiagIds037 i)).word (axisWitnesses037 i)=true := by decide +kernel
theorem axis_diag_fields_37 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds037 i)).level=(axisLookup (1184+i.val)).level ∧ (diagonalLookup (axisDiagIds037 i)).index=(axisLookup (1184+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
