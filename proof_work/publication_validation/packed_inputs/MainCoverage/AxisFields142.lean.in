def axisDiagIds142 : Fin 32 → ℕ := ![4550,4551,4552,4553,4554,4555,4556,4557,4558,4559,4560,4561,4562,4563,4564,4565,4566,4567,4568,4569,4570,4571,4572,4573,4574,4575,4576,4577,4578,4579,4580,4581]
theorem axis_fields_142 : ∀ i : Fin 32, axisCertificateOK (axisLookup (4544+i.val)) (diagonalLookup (axisDiagIds142 i)).word (axisWitnesses142 i)=true := by decide +kernel
theorem axis_diag_fields_142 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds142 i)).level=(axisLookup (4544+i.val)).level ∧ (diagonalLookup (axisDiagIds142 i)).index=(axisLookup (4544+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
