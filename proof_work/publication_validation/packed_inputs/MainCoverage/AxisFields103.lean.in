def axisDiagIds103 : Fin 32 → ℕ := ![3302,3303,3304,3305,3306,3307,3308,3309,3310,3311,3312,3313,3314,3315,3316,3317,3318,3319,3320,3321,3322,3323,3324,3325,3326,3327,3328,3329,3330,3331,3332,3333]
theorem axis_fields_103 : ∀ i : Fin 32, axisCertificateOK (axisLookup (3296+i.val)) (diagonalLookup (axisDiagIds103 i)).word (axisWitnesses103 i)=true := by decide +kernel
theorem axis_diag_fields_103 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds103 i)).level=(axisLookup (3296+i.val)).level ∧ (diagonalLookup (axisDiagIds103 i)).index=(axisLookup (3296+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
