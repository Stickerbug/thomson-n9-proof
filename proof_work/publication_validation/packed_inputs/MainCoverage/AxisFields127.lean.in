theorem axis_diag_fields_127 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds127 i)).level=(axisLookup (4064+i.val)).level ∧ (diagonalLookup (axisDiagIds127 i)).index=(axisLookup (4064+i.val)).index := by decide +kernel
