def axisDiagIds146 : Fin 32 → ℕ := ![4678,4679,4680,4681,4682,4683,4684,4685,4686,4687,4688,4689,4690,4691,4692,4693,4694,4695,4696,4697,4698,4699,4700,4701,4702,4703,4704,4705,4706,4707,4708,4709]
theorem axis_fields_146 : ∀ i : Fin 32, axisCertificateOK (axisLookup (4672+i.val)) (diagonalLookup (axisDiagIds146 i)).word (axisWitnesses146 i)=true := by decide +kernel
theorem axis_diag_fields_146 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds146 i)).level=(axisLookup (4672+i.val)).level ∧ (diagonalLookup (axisDiagIds146 i)).index=(axisLookup (4672+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
