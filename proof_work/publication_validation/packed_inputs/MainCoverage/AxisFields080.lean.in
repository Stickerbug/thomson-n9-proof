theorem axis_diag_fields_80 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds080 i)).level=(axisLookup (2560+i.val)).level ∧ (diagonalLookup (axisDiagIds080 i)).index=(axisLookup (2560+i.val)).index := by decide +kernel
