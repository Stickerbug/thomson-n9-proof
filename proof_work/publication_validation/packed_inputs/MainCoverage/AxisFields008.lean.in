def axisDiagIds008 : Fin 32 → ℕ := ![261,262,263,264,265,266,267,268,269,270,271,272,273,274,275,276,277,278,279,280,281,282,283,284,285,286,287,288,289,290,291,292]
theorem axis_fields_8 : ∀ i : Fin 32, axisCertificateOK (axisLookup (256+i.val)) (diagonalLookup (axisDiagIds008 i)).word (axisWitnesses008 i)=true := by decide +kernel
theorem axis_diag_fields_8 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds008 i)).level=(axisLookup (256+i.val)).level ∧ (diagonalLookup (axisDiagIds008 i)).index=(axisLookup (256+i.val)).index := by decide +kernel
