def axisDiagIds040 : Fin 32 → ℕ := ![1285,1286,1287,1288,1289,1290,1291,1292,1293,1294,1295,1296,1297,1298,1299,1300,1301,1302,1303,1304,1305,1306,1307,1308,1309,1310,1311,1312,1313,1314,1315,1316]
theorem axis_fields_40 : ∀ i : Fin 32, axisCertificateOK (axisLookup (1280+i.val)) (diagonalLookup (axisDiagIds040 i)).word (axisWitnesses040 i)=true := by decide +kernel
theorem axis_diag_fields_40 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds040 i)).level=(axisLookup (1280+i.val)).level ∧ (diagonalLookup (axisDiagIds040 i)).index=(axisLookup (1280+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
