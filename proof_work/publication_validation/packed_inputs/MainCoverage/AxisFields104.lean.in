def axisDiagIds104 : Fin 32 → ℕ := ![3334,3335,3336,3337,3338,3339,3340,3341,3342,3343,3344,3345,3346,3347,3348,3349,3350,3351,3352,3353,3354,3355,3356,3357,3358,3359,3360,3361,3362,3363,3364,3365]
theorem axis_fields_104 : ∀ i : Fin 32, axisCertificateOK (axisLookup (3328+i.val)) (diagonalLookup (axisDiagIds104 i)).word (axisWitnesses104 i)=true := by decide +kernel
theorem axis_diag_fields_104 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds104 i)).level=(axisLookup (3328+i.val)).level ∧ (diagonalLookup (axisDiagIds104 i)).index=(axisLookup (3328+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
