def axisDiagIds122 : Fin 32 → ℕ := ![3910,3911,3912,3913,3914,3915,3916,3917,3918,3919,3920,3921,3922,3923,3924,3925,3926,3927,3928,3929,3930,3931,3932,3933,3934,3935,3936,3937,3938,3939,3940,3941]
theorem axis_fields_122 : ∀ i : Fin 32, axisCertificateOK (axisLookup (3904+i.val)) (diagonalLookup (axisDiagIds122 i)).word (axisWitnesses122 i)=true := by decide +kernel
theorem axis_diag_fields_122 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds122 i)).level=(axisLookup (3904+i.val)).level ∧ (diagonalLookup (axisDiagIds122 i)).index=(axisLookup (3904+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
