def axisDiagIds131 : Fin 32 → ℕ := ![4198,4199,4200,4201,4202,4203,4204,4205,4206,4207,4208,4209,4210,4211,4212,4213,4214,4215,4216,4217,4218,4219,4220,4221,4222,4223,4224,4225,4226,4227,4228,4229]
theorem axis_fields_131 : ∀ i : Fin 32, axisCertificateOK (axisLookup (4192+i.val)) (diagonalLookup (axisDiagIds131 i)).word (axisWitnesses131 i)=true := by decide +kernel
theorem axis_diag_fields_131 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds131 i)).level=(axisLookup (4192+i.val)).level ∧ (diagonalLookup (axisDiagIds131 i)).index=(axisLookup (4192+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
