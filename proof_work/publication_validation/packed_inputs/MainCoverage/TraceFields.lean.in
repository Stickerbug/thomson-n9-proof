namespace ThomsonNine.MainEnvelope.Archive
theorem diagonal_exponents (k : Fin 21) : (diagonalGroups k).all (fun j => decide (ActualF.Data.support (Fin.ofNat 756 j) 1+ActualF.Data.support (Fin.ofNat 756 j) 2=k.val))=true := by
  fin_cases k
  · exact diagonal_exponents_0
  · exact diagonal_exponents_1
  · exact diagonal_exponents_2
  · exact diagonal_exponents_3
  · exact diagonal_exponents_4
  · exact diagonal_exponents_5
  · exact diagonal_exponents_6
  · exact diagonal_exponents_7
  · exact diagonal_exponents_8
  · exact diagonal_exponents_9
  · exact diagonal_exponents_10
  · exact diagonal_exponents_11
  · exact diagonal_exponents_12
  · exact diagonal_exponents_13
  · exact diagonal_exponents_14
  · exact diagonal_exponents_15
  · exact diagonal_exponents_16
  · exact diagonal_exponents_17
  · exact diagonal_exponents_18
  · exact diagonal_exponents_19
  · exact diagonal_exponents_20
theorem diagonal_coefficients (k : Fin 21) : diagonalCoeff k=((diagonalGroups k).map (fun j => symMid (Fin.ofNat 756 j))).sum := by
  fin_cases k
  · exact diagonal_coefficients_0
  · exact diagonal_coefficients_1
  · exact diagonal_coefficients_2
  · exact diagonal_coefficients_3
  · exact diagonal_coefficients_4
  · exact diagonal_coefficients_5
  · exact diagonal_coefficients_6
  · exact diagonal_coefficients_7
  · exact diagonal_coefficients_8
  · exact diagonal_coefficients_9
  · exact diagonal_coefficients_10
  · exact diagonal_coefficients_11
  · exact diagonal_coefficients_12
  · exact diagonal_coefficients_13
  · exact diagonal_coefficients_14
  · exact diagonal_coefficients_15
  · exact diagonal_coefficients_16
  · exact diagonal_coefficients_17
  · exact diagonal_coefficients_18
  · exact diagonal_coefficients_19
  · exact diagonal_coefficients_20
end ThomsonNine.MainEnvelope.Archive
