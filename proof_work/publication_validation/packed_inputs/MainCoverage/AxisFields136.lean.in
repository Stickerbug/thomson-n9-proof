def axisDiagIds136 : Fin 32 → ℕ := ![4358,4359,4360,4361,4362,4363,4364,4365,4366,4367,4368,4369,4370,4371,4372,4373,4374,4375,4376,4377,4378,4379,4380,4381,4382,4383,4384,4385,4386,4387,4388,4389]
theorem axis_fields_136 : ∀ i : Fin 32, axisCertificateOK (axisLookup (4352+i.val)) (diagonalLookup (axisDiagIds136 i)).word (axisWitnesses136 i)=true := by decide +kernel
theorem axis_diag_fields_136 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds136 i)).level=(axisLookup (4352+i.val)).level ∧ (diagonalLookup (axisDiagIds136 i)).index=(axisLookup (4352+i.val)).index := by decide +kernel
