def axisDiagIds149 : Fin 32 → ℕ := ![4774,4775,4776,4777,4778,4779,4780,4781,4782,4783,4784,4785,4786,4787,4788,4789,4790,4791,4792,4793,4794,4795,4796,4797,4798,4799,4800,4801,4802,4803,4804,4805]
theorem axis_fields_149 : ∀ i : Fin 32, axisCertificateOK (axisLookup (4768+i.val)) (diagonalLookup (axisDiagIds149 i)).word (axisWitnesses149 i)=true := by decide +kernel
theorem axis_diag_fields_149 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds149 i)).level=(axisLookup (4768+i.val)).level ∧ (diagonalLookup (axisDiagIds149 i)).index=(axisLookup (4768+i.val)).index := by decide +kernel
end ThomsonNine.PackedMain
