theorem axis_fields_20 : ∀ i : Fin 32, axisCertificateOK (axisLookup (640+i.val)) (diagonalLookup (axisDiagIds020 i)).word (axisWitnesses020 i)=true := by decide +kernel
theorem axis_diag_fields_20 : ∀ i : Fin 32, (diagonalLookup (axisDiagIds020 i)).level=(axisLookup (640+i.val)).level ∧ (diagonalLookup (axisDiagIds020 i)).index=(axisLookup (640+i.val)).index := by decide +kernel
